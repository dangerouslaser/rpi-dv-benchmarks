+   m_offset_pts = 0;
++  m_seekRecoverTime = DVD_NOPTS_VALUE;
+   m_CurrentAudio.lastdts = DVD_NOPTS_VALUE;
+   m_CurrentVideo.lastdts = DVD_NOPTS_VALUE;
+ 
+@@ -1841,6 +1843,34 @@ void CVideoPlayer::Process()
