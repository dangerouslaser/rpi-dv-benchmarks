+   m_playSpeed = DVD_PLAYSPEED_NORMAL;
+   m_streamPlayerSpeed = DVD_PLAYSPEED_NORMAL;
+   m_caching = CACHESTATE_DONE;
+@@ -1465,6 +1466,7 @@ void CVideoPlayer::Prepare()
+   m_CurrentAudioID3.hint.Clear();
