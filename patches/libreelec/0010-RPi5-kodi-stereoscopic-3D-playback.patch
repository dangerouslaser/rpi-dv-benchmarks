diff --git a/projects/RPi/devices/RPi5/patches/kodi/0010-RendererDRMPRIMEGLES-honour-the-source-rectangle-whe.patch b/projects/RPi/devices/RPi5/patches/kodi/0010-RendererDRMPRIMEGLES-honour-the-source-rectangle-whe.patch
new file mode 100644
index 0000000000..9648fc9411
--- /dev/null
+++ b/projects/RPi/devices/RPi5/patches/kodi/0010-RendererDRMPRIMEGLES-honour-the-source-rectangle-whe.patch
@@ -0,0 +1,185 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Dom Cobley <popcornmix@gmail.com>
+Date: Sun, 26 Jul 2026 17:15:18 +0100
+Subject: [PATCH 10/46] RendererDRMPRIMEGLES: honour the source rectangle when
+ sampling
+
+Both draw paths hardcoded texture coordinates 0..1, so a side-by-side or
+top-and-bottom source was tiled whole into each eye instead of showing the eye
+CBaseRenderer::ManageRenderArea() had cropped m_sourceRect to.
+
+Derive the texture coordinates from m_sourceRect instead. There is no
+stereoscopic branch: for 2D content m_sourceRect is the whole frame, so the
+normalised rect is exactly 0..1 and the output is unchanged. Per-plane
+texcoords are normalised - each EGL-imported texture covers its whole plane
+regardless of chroma subsampling - so the same fractional crop applies to all
+three planes of the limited-range path as well as to the OES path.
+
+DrawTexture() is shared with direct-to-plane screencap and is static, so it
+takes the crop as a parameter rather than reading m_sourceRect: Render() passes
+the cropped rect, and the screencap keeps the whole frame it drew before, so a
+stereoscopic source is captured packed as the plane scans it out rather than
+cropped to whichever eye happens to be drawing.
+
+(cherry picked from commit dd656492748766c95943452b49bb2bebfce274ad)
+---
+ .../HwDecRender/DRMPRIMECaptureGLES.cpp       |  5 +-
+ .../HwDecRender/RendererDRMPRIMEGLES.cpp      | 49 +++++++++++--------
+ .../HwDecRender/RendererDRMPRIMEGLES.h        | 16 ++++--
+ 3 files changed, 45 insertions(+), 25 deletions(-)
+
+diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/DRMPRIMECaptureGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/DRMPRIMECaptureGLES.cpp
+index 7c62cdca6..0a4929761 100644
+--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/DRMPRIMECaptureGLES.cpp
++++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/DRMPRIMECaptureGLES.cpp
+@@ -110,7 +110,10 @@ bool CaptureDRMPRIMEVideo(CVideoBufferDRMPRIME* buffer,
+                             {static_cast<float>(width), 0.0f},
+                             {static_cast<float>(width), static_cast<float>(height)},
+                             {0.0f, static_cast<float>(height)}};
+-    CRendererDRMPRIMEGLES::DrawTexture(*renderSystem, texture.GetTexture(), dest);
++    // whole buffer: a stereoscopic source is captured packed, as the plane
++    // scans it out, rather than cropped to whichever eye is drawing now
++    CRendererDRMPRIMEGLES::DrawTexture(*renderSystem, texture.GetTexture(), dest,
++                                       CRect(0.0f, 0.0f, 1.0f, 1.0f));
+ 
+     glMatrixProject.PopLoad();
+     glMatrixModview.PopLoad();
+diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIMEGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIMEGLES.cpp
+index e1ccc815f..3f17f5f7c 100644
+--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIMEGLES.cpp
++++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIMEGLES.cpp
+@@ -446,6 +446,12 @@ bool CRendererDRMPRIMEGLES::ConfigChanged(const VideoPicture& picture)
+   return false;
+ }
+ 
++CRect CRendererDRMPRIMEGLES::GetNormalisedSourceRect() const
++{
++  return CRect(m_sourceRect.x1 / m_sourceWidth, m_sourceRect.y1 / m_sourceHeight,
++               m_sourceRect.x2 / m_sourceWidth, m_sourceRect.y2 / m_sourceHeight);
++}
++
