diff --git a/projects/RPi/devices/RPi5/patches/kodi/0014-BaseRenderer-correct-per-eye-aspect-for-full-side-by.patch b/projects/RPi/devices/RPi5/patches/kodi/0014-BaseRenderer-correct-per-eye-aspect-for-full-side-by.patch
