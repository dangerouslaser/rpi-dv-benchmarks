++                                  0x00, 0x00, 0x01, 0x14, 0x01, 0x02};
++
++  OffsetMetadata metadata;
++  EXPECT_FALSE(Parse(unit, metadata));
++}
++
++TEST(TestBlurayOffsetMetadata, RejectsMetadataThatDoesNotFit)
++{
