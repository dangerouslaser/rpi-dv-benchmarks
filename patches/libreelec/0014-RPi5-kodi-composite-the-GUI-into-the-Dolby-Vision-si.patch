++    {
++      if (areas[i + 1].y1 - areas[i].y2 < areas[nearest + 1].y1 - areas[nearest].y2)
++        nearest = i;
++    }
++    areas[nearest].Union(areas[nearest + 1]);
++    areas.erase(areas.begin() + nearest + 1);
++  }
++  return areas;
