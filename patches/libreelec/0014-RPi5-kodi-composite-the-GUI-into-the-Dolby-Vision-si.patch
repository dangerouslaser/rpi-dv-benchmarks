++/*!
++ * \brief Areas in bands of rows that cover the regions: regions sharing rows, or nearly, are one
++ * area; beyond max areas, the two nearest are joined.
++ */
++std::vector<CRect> GroupRows(std::vector<CRect> regions, size_t max)
++{
++  std::erase_if(regions, [](const CRect& region) { return region.IsEmpty(); });
++  std::ranges::sort(regions, {}, &CRect::y1);
++  // regions this close in rows share the engine's margins anyway
++  constexpr float NEAR = 16.0f;
++  std::vector<CRect> areas;
++  for (const CRect& region : regions)
++  {
++    if (!areas.empty() && region.y1 <= areas.back().y2 + NEAR)
++      areas.back().Union(region);
++    else
++      areas.push_back(region);
