++namespace
++{
++// one on the plane, one leaving it, one being rendered, one spare
++constexpr int OUTPUTS = 4;
++
++void Log(void* /*opaque*/, pi_log_level level, const char* message)
++{
++  int kodiLevel = LOGDEBUG;
++  if (level == PI_LOG_ERROR)
++    kodiLevel = LOGERROR;
++  else if (level == PI_LOG_WARNING)
++    kodiLevel = LOGWARNING;
++  else if (level == PI_LOG_INFO)
++    kodiLevel = LOGINFO;
++
++  std::string text(message);
++  StringUtils::TrimRight(text);
++  CLog::Log(kodiLevel, "CDVTunnelDRMPRIME: {}", text);
++}
++
++// the system heap: CMA is the decoder's, and the display scans out of either
++int AllocateDmaBuf(uint64_t size)
++{
++  int heap = open("/dev/dma_heap/system", O_RDWR | O_CLOEXEC);
++  if (heap < 0)
++    return -1;
++
++  dma_heap_allocation_data data{};
++  data.len = size;
++  data.fd_flags = O_RDWR | O_CLOEXEC;
++  int ret = ioctl(heap, DMA_HEAP_IOCTL_ALLOC, &data);
++  close(heap);
++
++  return ret < 0 ? -1 : static_cast<int>(data.fd);
++}
++} // namespace
