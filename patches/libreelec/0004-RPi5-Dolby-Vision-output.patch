++CVideoBufferDRMPRIME* CDVTunnelDRMPRIME::Render(CVideoBufferDRMPRIME* buffer, int& fence)
++{
++  fence = -1;
++
++  auto* decoded = dynamic_cast<CVideoBufferDRMPRIMEFFmpeg*>(buffer);
++  if (!decoded)
++    return nullptr;
++
++  auto* output = static_cast<CDVTunnelOutput*>(m_pool->Get());
++  if (!output)
++  {
++    CLog::Log(LOGWARNING, "CDVTunnelDRMPRIME: no free output");
++    return nullptr;
++  }
++
++  pi_frame frame{};
++  frame.bl = decoded->GetFrame();
++  frame.chroma_top_left = pi_chroma_top_left(frame.bl, m_info.profile);
++  frame.pts_us = static_cast<int64_t>(buffer->GetPicture().pts);
++  frame.acquire_fd = -1;
++
++  int ret = pi_render(m_engine, &frame, output->m_output, &fence);
++  if (ret != PI_OK)
++  {
++    if (m_failures++ == 0)
++      CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: render: {}", pi_strerror(ret));
++    output->Release();
++    return nullptr;
++  }
++
++  return output;
++}
