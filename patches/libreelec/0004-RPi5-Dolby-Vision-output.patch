++  int SendPacket(const AVPacket* packet);
++  //! \return as avcodec_receive_frame(), with the base layer's picture
++  int ReceiveFrame(AVFrame* frame);
++  //! \brief Gives the last received picture's enhancement layer to the buffer
++  void Attach(CVideoBufferDRMPRIMEFFmpeg* buffer);
++  //! \brief Drains the enhancement layer's decoder (the base layer's is the caller's)
++  void Drain();
++  //! \brief After the base layer's decoder is flushed: drops everything held
++  void Flush();
++
++private:
++  CDVELDecoderDRMPRIME() = default;
++
++  int Send(int layer, const AVPacket* packet);
++  int Receive(int layer);
++  int Held(int layer) const;
++  AVPacket* LayerPacket(int layer, const AVPacket* packet) const;
++  void LogPairing();
++
++  AVCodecContext* m_decoder[2] = {}; //!< the base layer's isn't owned
++  AVPacket* m_pending[2] = {};
++  bool m_eof[2] = {};
++  pi_pairer* m_pairer = nullptr;
++  AVFrame* m_enhancementLayer = nullptr;
++  int m_nalSize = 4;
++  int m_queueSize = 0;
++  unsigned int m_logged[3] = {};
++};
