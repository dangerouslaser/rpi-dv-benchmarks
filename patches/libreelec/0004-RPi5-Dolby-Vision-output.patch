++CDVTunnelDRMPRIME::~CDVTunnelDRMPRIME()
++{
++  if (!m_engine)
++    return;
++
++  pi_stream_close(m_engine);
++  if (m_pool)
++    m_pool->ReleaseImports(m_engine);
++  pi_engine_destroy(m_engine);
++}
