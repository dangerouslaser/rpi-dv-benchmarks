++//! \brief A tunnel frame: an XRGB8888 linear dma-buf the engine renders into
++class CDVTunnelOutput : public CVideoBufferDRMPRIME
++{
++public:
++  CDVTunnelOutput(int id, int fd, uint32_t width, uint32_t height, uint32_t stride, uint64_t size)
++    : CVideoBufferDRMPRIME(id), m_fd(fd), m_size(size), m_stride(stride)
++  {
++    m_descriptor.nb_objects = 1;
++    m_descriptor.objects[0].fd = fd;
++    m_descriptor.objects[0].size = size;
++    m_descriptor.objects[0].format_modifier = DRM_FORMAT_MOD_LINEAR;
++    m_descriptor.nb_layers = 1;
++    m_descriptor.layers[0].format = DRM_FORMAT_XRGB8888;
++    m_descriptor.layers[0].nb_planes = 1;
++    m_descriptor.layers[0].planes[0].object_index = 0;
++    m_descriptor.layers[0].planes[0].offset = 0;
++    m_descriptor.layers[0].planes[0].pitch = stride;
++
++    VideoPicture picture;
++    picture.Reset();
++    picture.iWidth = picture.iDisplayWidth = width;
++    picture.iHeight = picture.iDisplayHeight = height;
++    picture.color_range = 1;
++    picture.colorBits = 8;
++    SetPictureParams(picture);
++  }
++
++  ~CDVTunnelOutput() override { close(m_fd); }
++
++  AVDRMFrameDescriptor* GetDescriptor() const override { return &m_descriptor; }
++
++  int m_fd;
++  uint64_t m_size;
++  uint32_t m_stride;
++  pi_output* m_output = nullptr;
++
++private:
++  mutable AVDRMFrameDescriptor m_descriptor{};
++};
++
++//! \brief The tunnel's outputs. An output on the video plane holds the pool, so it outlives the engine.
++class CDVTunnelOutputPool : public IVideoBufferPool
++{
++public:
++  CVideoBuffer* Get() override
++  {
++    std::unique_lock lock(m_critSection);
++    if (m_free.empty())
++      return nullptr;
++
++    CDVTunnelOutput* output = m_outputs[m_free.front()].get();
++    m_free.pop_front();
++    output->Acquire(GetPtr());
++    return output;
++  }
++
++  void Return(int id) override
++  {
++    std::unique_lock lock(m_critSection);
++    m_free.push_back(id);
++  }
++
++  void Add(std::unique_ptr<CDVTunnelOutput> output)
++  {
++    std::unique_lock lock(m_critSection);
++    m_free.push_back(static_cast<int>(m_outputs.size()));
++    m_outputs.emplace_back(std::move(output));
++  }
++
++  void ReleaseImports(pi_engine* engine)
++  {
++    std::unique_lock lock(m_critSection);
++    for (auto& output : m_outputs)
++    {
++      if (output->m_output)
++        pi_output_release(engine, output->m_output);
++      output->m_output = nullptr;
++    }
++  }
++
++private:
++  CCriticalSection m_critSection;
++  std::vector<std::unique_ptr<CDVTunnelOutput>> m_outputs;
++  std::deque<int> m_free;
++};
++
++bool CDVTunnelDRMPRIME::Supports(const VideoPicture& picture)
++{
++  if (picture.hdrType != StreamHdrType::HDR_TYPE_DOLBYVISION ||
++      (picture.doviProfile != 5 && picture.doviProfile != 7 && picture.doviProfile != 8))
++    return false;
++
++  static const bool available = []
++  {
++    pi_probe_info info{};
++    if (pi_api_version() != PI_API_VERSION || pi_probe(nullptr, &info) != PI_OK)
++    {
++      CLog::Log(LOGINFO, "CDVTunnelDRMPRIME: no Vulkan device for the Dolby Vision engine");
++      return false;
++    }
++    // a CPU implementation isn't real time, and KMS needs the render's fence
++    if (info.cpu || !info.release_fence)
++    {
++      CLog::Log(LOGINFO, "CDVTunnelDRMPRIME: {} can't drive the Dolby Vision engine",
++                info.device);
++      return false;
++    }
++    return true;
++  }();
++
++  return available;
++}
