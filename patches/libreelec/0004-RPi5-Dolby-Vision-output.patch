++void CDVTunnelDRMPRIME::Flush()
++{
++  int ret = pi_stream_open(m_engine, &m_info);
++  if (ret != PI_OK)
++    CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: stream: {}", pi_strerror(ret));
