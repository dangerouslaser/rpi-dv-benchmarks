++class CDVELDecoderDRMPRIME
++{
++public:
++  ~CDVELDecoderDRMPRIME();
++
++  /*!
++   * \brief For a profile 7 stream with an enhancement layer, in length-prefixed
++   * NAL units, when the display gets standard Dolby Vision.
