++std::unique_ptr<CDVTunnelDRMPRIME> CDVTunnelDRMPRIME::Create(const VideoPicture& picture,
++                                                             const Options& options)
++{
++  std::unique_ptr<CDVTunnelDRMPRIME> tunnel(new CDVTunnelDRMPRIME());
++  tunnel->m_options = options;
++  tunnel->m_pipelineCache = CSpecialProtocol::TranslatePath("special://temp/pi_engine.cache");
++
++  pi_options o;
++  pi_options_default(&o);
++  o.mmr = options.mmr;
++  o.filters = options.filters;
++  o.el_upscale = options.elUpscale;
++  o.pipeline_cache = tunnel->m_pipelineCache.c_str();
++  o.log = Log;
++  o.log_level = PI_LOG_INFO;
++
++  int ret = pi_engine_create(&o, &tunnel->m_engine);
++  if (ret != PI_OK)
++  {
++    CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: engine: {}", pi_strerror(ret));
++    return nullptr;
++  }
++
++  tunnel->m_info.width = picture.iWidth;
++  tunnel->m_info.height = picture.iHeight;
++  tunnel->m_info.profile = picture.doviProfile;
++  ret = pi_stream_open(tunnel->m_engine, &tunnel->m_info);
++  if (ret != PI_OK)
++  {
++    CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: stream {}x{}: {}", picture.iWidth, picture.iHeight,
++              pi_strerror(ret));
++    return nullptr;
++  }
++
++  uint32_t stride;
++  uint64_t bytes;
++  ret = pi_output_size(picture.iWidth, picture.iHeight, &stride, &bytes);
++  if (ret != PI_OK)
++    return nullptr;
++  bytes = (bytes + 4095) & ~static_cast<uint64_t>(4095);
++
++  tunnel->m_pool = std::make_shared<CDVTunnelOutputPool>();
++  for (int i = 0; i < OUTPUTS; i++)
++  {
++    int fd = AllocateDmaBuf(bytes);
++    if (fd < 0)
++    {
++      CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: no {} byte buffer from the system DMA heap", bytes);
++      return nullptr;
++    }
++
++    auto output = std::make_unique<CDVTunnelOutput>(i, fd, picture.iWidth, picture.iHeight,
++                                                    stride, bytes);
++    ret = pi_output_import(tunnel->m_engine, fd, picture.iWidth, picture.iHeight, stride, bytes,
++                           &output->m_output);
++    if (ret != PI_OK)
++    {
++      CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: output import: {}", pi_strerror(ret));
++      return nullptr;
++    }
++    tunnel->m_pool->Add(std::move(output));
++  }
++
++  CLog::Log(LOGINFO, "CDVTunnelDRMPRIME: profile {} at {}x{}: {}", picture.doviProfile,
++            picture.iWidth, picture.iHeight, pi_engine_describe(tunnel->m_engine));
++
++  return tunnel;
++}
