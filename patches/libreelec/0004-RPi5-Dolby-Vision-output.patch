++
++  int ret = pi_engine_configure(m_engine, &o);
++  if (ret == PI_OK)
++    ret = pi_stream_open(m_engine, &m_info);
++
++  if (ret != PI_OK)
++  {
++    CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: options: {}", pi_strerror(ret));
++    return false;
++  }
++
++  m_options = options;
++  m_failures = 0;
++  CLog::Log(LOGINFO, "CDVTunnelDRMPRIME: {}, enhancement layer {}", pi_engine_describe(m_engine),
