 layout(constant_id = 20) const uint S_NEAREST = 255u;
 #define nearest SPEC_OR_PUSH(S_NEAREST, p_nearest)
+// Samples per invocation: 4 (two pairs, the original) or 2 (one pair: about
+// half the live registers, for GPUs that need them for threads, e.g. V3D).
+// The engine dispatches width / S_PIXELS invocations per row.
+layout(constant_id = 27) const uint S_PIXELS = 4;
 HORIZONTAL(horizontal0, el0)
 HORIZONTAL(horizontal1, el1)
 
@@ -96,8 +102,73 @@ void mmr64_dual_pixel(uvec3 s, uvec2 enhancement, out uvec2 o, out bvec2 ok)
 
 uint half16(uint d, uint k) { return k == 0u ? d & 0xffffu : d >> 16; }
 
+// The EL chroma at sample pair (e0 even sample, its odd neighbour) of one
+// channel's row: Annex B's 8-tap (EL e0-3 .. e0+4), bilinear or nearest.
+// Words loaded where the 10-sample window e0-4|e0-3 .. fits, the filter
+// accumulated at once (no window kept); edge() samples otherwise.
+uvec2 el_pair_narrow(uint rb, uint e0, uint ew, bool second)
+{
+    uint even = second ? uint(el1[rb + e0]) : uint(el0[rb + e0]);
+    if (nearest == EL_NEAREST)
+        return uvec2(even);
+    if (nearest == EL_BILINEAR) {
+        uint j = rb + uint(edge(int(e0) + 1, ew));
+        return uvec2(even, bilinear_mid(even, second ? uint(el1[j]) : uint(el0[j])));
+    }
+    const int taps[8] = int[8](22, 94, -524, 2456, 2456, -524, 94, 22);
+    int s = 0;
+    if (e0 >= 4u && e0 + 6u < ew) {
+        // elements (rb + e0 - 3) .. + 7 inside the words from (rb + e0 - 4) & ~1
+        uint start = rb + e0 - 4u, o = start & 1u, base = start >> 1;
+        uint w[5];
+        for (uint k = 0; k < 5; ++k)
+            w[k] = second ? el1w[base + k] : el0w[base + k];
+        for (uint k = 0; k < 8; ++k) {
+            // element (start + 1 + k): word (o + 1 + k) >> 1, half (o + 1 + k) & 1
+            uint lo = (w[(k + 1u) >> 1] >> (((k + 1u) & 1u) * 16u)) & 0xffffu;
+            uint hi = (w[(k + 2u) >> 1] >> (((k + 2u) & 1u) * 16u)) & 0xffffu;
+            s += taps[k] * int(o != 0u ? hi : lo);
+        }
+    } else
+        for (int k = 0; k < 8; ++k) {
+            uint j = rb + uint(edge(int(e0) + k - 3, ew));
+            s += taps[k] * int(second ? uint(el1[j]) : uint(el0[j]));
+        }
+    return uvec2(even, rounded(s, 4096));
+}
+
 void main()
 {
+    if (S_PIXELS == 2u) {
+        // one even/odd pair (x, x + 1) of a chroma row
+        uint x = gl_GlobalInvocationID.x * 2u, row = gl_GlobalInvocationID.y + row_offset;
+        if (x >= width || row >= rows)
+            return;
+        uint first = row * width + x, ew = width / 2, e0 = x / 2;
+        uint g = ygw[first >> 1], pb = bphasew[first >> 1], pr = bphasew[(width * rows + first) >> 1];
+        uvec2 e[2];
+        if (HORIZONTAL_FUSED != 0u) {
+            uint rb = row * ew;
+            uvec2 c0 = el_pair_narrow(rb, e0, ew, false), c1 = el_pair_narrow(rb, e0, ew, true);
+            e[0] = uvec2(c0.x, c1.x);
+            e[1] = uvec2(c0.y, c1.y);
+        } else
+            for (uint l = 0; l < 2; ++l)
+                e[l] = uvec2(uint(el0[first + l]), uint(el1[first + l]));
+        uvec2 o[2];
+        bvec2 ok[2];
+        for (uint l = 0; l < 2; ++l)
+            mmr64_dual_pixel(uvec3(half16(g, l), half16(pb, l), half16(pr, l)), e[l], o[l], ok[l]);
+        if (all(ok[0]) && all(ok[1])) {
+            out0d[first >> 1] = o[0].x | (o[1].x << 16);
+            out1d[first >> 1] = o[0].y | (o[1].y << 16);
+        } else
+            for (uint l = 0; l < 2; ++l) {
+                if (ok[l].x) out0[first + l] = uint16_t(o[l].x);
+                if (ok[l].y) out1[first + l] = uint16_t(o[l].y);
+            }
+        return;
+    }
     // perf experiment: two pairs per invocation (x .. x+3, x % 4 == 0; width % 4 == 0)
     uint x = gl_GlobalInvocationID.x * 4u, row = gl_GlobalInvocationID.y + row_offset;
     if (x >= width || row >= rows)
