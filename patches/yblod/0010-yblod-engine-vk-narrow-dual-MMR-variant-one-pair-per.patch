+++ b/yblod-engine/vk/shaders/fel_mmr_dual_horizontal.comp
@@ -22,10 +22,16 @@ layout(binding = 6, std430) writeonly buffer O0 { uint16_t out0[]; };
 layout(binding = 6, std430) writeonly buffer O0W { uvec2 out0w[]; };
 layout(binding = 7, std430) writeonly buffer O1 { uint16_t out1[]; };
