 yblod-engine/vk/shaders/table_add.comp        |  2 +-
 yblod-engine/vk/src/bin/dvvk-int64-check.rs   | 74 +++++++++++++++++++
 yblod-engine/vk/src/device.rs                 | 15 +++-
 yblod-engine/vk/src/gpu.rs                    | 15 +++-
 yblod-engine/vk/src/options.rs                |  4 +
 14 files changed, 314 insertions(+), 61 deletions(-)
