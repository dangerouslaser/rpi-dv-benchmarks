diff --git a/yblod-engine/vk/shaders/int64_check.comp b/yblod-engine/vk/shaders/int64_check.comp
new file mode 100644
index 0000000..e54348f
--- /dev/null
+++ b/yblod-engine/vk/shaders/int64_check.comp
@@ -0,0 +1,57 @@
+// Test only (dvvk-int64-check): dv_common.glsl's emulated 64-bit helpers
+// against native int64 on the same pseudo-random inputs (edge values mixed
+// in). Needs a device with shaderInt64 (lavapipe, desktop GPUs); counts
+// mismatches per helper and keeps the first failing input.
+#version 460
+#ifndef DV_NO_INT64
+#define DV_NO_INT64
+#endif
+#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
+#include "dv_common.glsl"
+layout(local_size_x = 64) in;
+layout(binding = 0, std430) buffer Result { uint mismatches[16]; uint first[16][4]; };
+layout(push_constant) uniform Push { uint seed; };
+
+uint pcg(inout uint s) { s = s * 747796405u + 2891336453u; uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u; return (w >> 22u) ^ w; }
+uint value(inout uint s)
+{
+    uint pick = pcg(s) & 15u, r = pcg(s);
+    return pick == 0u ? 0u : pick == 1u ? 0xffffffffu : pick == 2u ? 0x80000000u : pick == 3u ? 0x7fffffffu
+         : pick == 4u ? (r & 0xffu) : pick == 5u ? (0xffffff00u | (r & 0xffu)) : pick == 6u ? (r & 0xfffffu) : r;
+}
+int64_t native(uvec2 v) { return int64_t((uint64_t(v.y) << 32) | uint64_t(v.x)); }
+uvec2 words(int64_t v) { return uvec2(uint(uint64_t(v)), uint(uint64_t(v) >> 32)); }
+void check(uint op, bool ok, uint a, uint b, uint c, uint d)
+{
+    if (!ok && atomicAdd(mismatches[op], 1u) == 0u)
+        first[op] = uint[4](a, b, c, d);
+}
+
+void main()
+{
+    uint s = gl_GlobalInvocationID.x * 2654435761u ^ seed;
+    uvec2 a = uvec2(value(s), value(s)), b = uvec2(value(s), value(s));
+    uint u = value(s), shift = 1u + pcg(s) % 63u, q = 1u + pcg(s) % 63u;
+    int i = int(value(s)), j = int(value(s));
+    int64_t na = native(a), nb = native(b);
+    check(0u, i64_add(a, b) == words(na + nb), a.x, a.y, b.x, b.y);
+    check(1u, i64_mul_u32(a, u) == words(na * int64_t(u)), a.x, a.y, u, 0u);
+    check(2u, i64_mul_i32_u32(i, u) == words(int64_t(i) * int64_t(uint64_t(u))), uint(i), u, 0u, 0u);
+    check(3u, i64_mul_i32_i32(i, j) == words(int64_t(i) * int64_t(j)), uint(i), uint(j), 0u, 0u);
+    uvec2 pos = uvec2(a.x, a.y & 0x7fffffffu);
+    check(4u, i64_shr_min16(pos, shift) == uint(min(uint64_t(native(pos)) >> shift, uint64_t(65535))), pos.x, pos.y, shift, 0u);
+    check(5u, u64_mulshr(u, b.x, q) == uint((uint64_t(u) * uint64_t(b.x)) >> q), u, b.x, q, 0u);
+    check(6u, i64_negative(a) == (na < 0), a.x, a.y, 0u, 0u);
+    // recon12 / overflows32 on sums the shaders form: uint table value + int residual,
+    // and on arbitrary 64-bit values.
+    uvec2 sum = SUM64(u, i);
+    int64_t nsum = int64_t(u) + int64_t(i);
+    check(7u, sum == words(nsum), u, uint(i), 0u, 0u);
+    int64_t r = nsum;
+    uint want = uint(clamp(r > -8 ? (r + 8) / 16 : int64_t(0), int64_t(0), int64_t(4095)));
+    check(8u, recon12(sum) == want, u, uint(i), 0u, 0u);
+    want = uint(clamp(na > -8 ? (na + 8) / 16 : int64_t(0), int64_t(0), int64_t(4095)));
+    check(9u, recon12(a) == want, a.x, a.y, 0u, 0u);
+    check(10u, overflows32(a) == (na > int64_t(2147483647) || na < int64_t(-2147483647) - 1), a.x, a.y, 0u, 0u);
+    check(11u, overflows32(sum) == (nsum > int64_t(2147483647) || nsum < int64_t(-2147483647) - 1), u, uint(i), 0u, 0u);
+}
