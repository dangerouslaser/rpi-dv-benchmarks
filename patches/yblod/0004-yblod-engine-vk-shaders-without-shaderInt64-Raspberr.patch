 {
     int hi, lo;
     imulExtended(int(coefficient), int(f), hi, lo);
     return packInt2x32(ivec2(lo, hi));
 }
+#endif
 
 // One channel's Q16 mapping, kind 3 (64-bit LUT), 2 (96-bit) or 1 (128-bit).
 uint mmr_mapped(uint P0, uint T0, uint kind, uvec3 s)
@@ -116,18 +120,18 @@ uint mmr_mapped(uint P0, uint T0, uint kind, uvec3 s)
     s.z = clamp(s.z, p[P0 + 6], p[P0 + 7]);
     uint xy = s.x * s.y, shift = p[P0 + 1] + 4u;
     if (kind == 3u) {
-        int64_t v = int64_t((uint64_t(p[P0 + 9]) << 32) | uint64_t(p[P0 + 8]));
-        v += table[T0 + s.x]; v += table[T0 + 1024u + s.y]; v += table[T0 + 2048u + s.z];
+        I64_T v = WORDS64(p[P0 + 8], p[P0 + 9]);
+        ACC64(v, table[T0 + s.x]); ACC64(v, table[T0 + 1024u + s.y]); ACC64(v, table[T0 + 2048u + s.z]);
         for (uint k = 3; k < 7; k++) {
             uint a = feature(k, s, xy);
-            v += term(p[P0 + 12 + 4 * k], a);
+            ACC64(v, term(p[P0 + 12 + 4 * k], a));
             if (p[P0] > 1u) {
                 uint b = feature_product(a, a);
-                v += term(p[P0 + 40 + 4 * k], b);
-                if (p[P0] > 2u) v += term(p[P0 + 68 + 4 * k], feature_product(a, b));
+                ACC64(v, term(p[P0 + 40 + 4 * k], b));
+                if (p[P0] > 2u) ACC64(v, term(p[P0 + 68 + 4 * k], feature_product(a, b)));
             }
         }
-        return v < 0 ? 0u : uint(min(uint64_t(v) >> shift, uint64_t(65535)));
+        return MAP16(v, shift);
     }
     uvec4 v;
     if (kind == 2u) {
@@ -196,7 +200,7 @@ void main()
             m = uint(cmap[channel * 1024u + phase[channel]]);
         } else
             m = mmr_mapped(channel * 96u, channel * 3072u, dual != 0u ? 3u : kinds[channel], s);
-        int64_t total = int64_t(m) + int64_t(rt[(1u + channel) * 1024u + e]);
+        I64_T total = SUM64(m, rt[(1u + channel) * 1024u + e]);
