diff --git a/yblod-engine/vk/src/bin/dvvk-int64-check.rs b/yblod-engine/vk/src/bin/dvvk-int64-check.rs
new file mode 100644
index 0000000..457dd4a
--- /dev/null
+++ b/yblod-engine/vk/src/bin/dvvk-int64-check.rs
@@ -0,0 +1,74 @@
+//! dvvk-int64-check [NODE] [ROUNDS]: the shaders' emulated 64-bit integer
+//! helpers (dv_common.glsl, DV_NO_INT64: the Raspberry Pi 5's path) against
+//! native int64 on this device, which must have shaderInt64 (lavapipe or a
+//! desktop GPU). NODE "-" (default): no DRM node, the first Vulkan device.
+//! Exit 0 when every helper matches on every input.
+use ash::vk;
+use dv_engine_vk::device::Device;
+use dv_engine_vk::gpu::{self, Bind, HostBuffer, OneShot, Pipeline, PushDescriptor};
+
+const OPS: [&str; 12] = [
+    "i64_add",
+    "i64_mul_u32",
+    "i64_mul_i32_u32",
+    "i64_mul_i32_i32",
+    "i64_shr_min16",
+    "u64_mulshr",
+    "i64_negative",
+    "SUM64",
+    "recon12(sum)",
+    "recon12(any)",
+    "overflows32(any)",
+    "overflows32(sum)",
+];
+
+fn main() {
+    let node = std::env::args().nth(1).unwrap_or_else(|| "-".into());
+    let rounds: u32 = std::env::args().nth(2).and_then(|v| v.parse().ok()).unwrap_or(16);
+    let fd = if node == "-" {
+        -1
+    } else {
+        let path = std::ffi::CString::new(node.clone()).unwrap();
+        unsafe { libc::open(path.as_ptr(), libc::O_RDWR | libc::O_CLOEXEC) }
+    };
+    let mut options = dv_engine_vk::options::EngineOptions::from_env();
+    options.no_int64 = false;
+    let d = Device::new(fd, options).unwrap_or_else(|e| panic!("device: {e}"));
+    println!("device: {} ({})", d.name, d.driver);
+    if !d.int64 {
+        eprintln!("this device has no shaderInt64: nothing to compare against");
+        std::process::exit(2);
+    }
+    let pipe = Pipeline::new(&d, "int64_check", &[vk::DescriptorType::STORAGE_BUFFER], 4, &[])
+        .unwrap_or_else(|e| panic!("pipeline: {e}"));
+    let mut result = HostBuffer::new(&d, 16 * 4 + 16 * 16, vk::BufferUsageFlags::STORAGE_BUFFER).unwrap();
+    result.bytes_mut().fill(0);
+    let push = PushDescriptor::new(&d);
+    let shot = OneShot::new(&d).unwrap();
+    const GROUPS: u32 = 4096; // 262144 inputs per round
+    for round in 0..rounds {
+        let cmd = shot.begin(&d).unwrap();
+        push.begin(cmd);
+        unsafe { d.device.cmd_bind_pipeline(cmd, vk::PipelineBindPoint::COMPUTE, pipe.pipeline) };
+        push.bind(cmd, &pipe, &[Bind::Buffer(result.buffer)]);
+        gpu::push_constants(&d, cmd, &pipe, &(round.wrapping_mul(0x9e37_79b9) ^ 0x5bd1_e995));
+        unsafe { d.device.cmd_dispatch(cmd, GROUPS, 1, 1) };
+        gpu::compute_to_host(&d, cmd);
+        shot.submit_wait(&d, &[], &[]).unwrap();
+    }
+    let words: Vec<u32> = result.bytes().chunks(4).map(|c| u32::from_le_bytes(c.try_into().unwrap())).collect();
+    let inputs = rounds as u64 * GROUPS as u64 * 64;
+    let mut failed = false;
+    for (op, name) in OPS.iter().enumerate() {
+        let n = words[op];
+        let f = &words[16 + op * 4..16 + op * 4 + 4];
+        if n == 0 {
+            println!("ok    {name:<18} {inputs} inputs");
+        } else {
+            failed = true;
+            println!("FAIL  {name:<18} {n} mismatches, first input {:08x} {:08x} {:08x} {:08x}", f[0], f[1], f[2], f[3]);
+        }
+    }
+    push.destroy();
+    std::process::exit(failed as i32);
+}
