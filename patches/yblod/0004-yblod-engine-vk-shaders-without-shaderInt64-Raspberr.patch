+/// `name`'s SPIR-V for this device: the "@noi64" build without shaderInt64.
+pub fn spirv_for(d: &Device, name: &str) -> Result<Vec<u32>> {
+    if d.int64 {
+        return spirv(name);
+    }
+    let bytes = SHADERS
+        .iter()
+        .find(|(n, _)| n.strip_suffix("@noi64") == Some(name))
+        .map(|(_, b)| *b)
+        .ok_or(Error::Missing("a shader"))?;
+    Ok(bytes.as_chunks::<4>().0.iter().map(|c| u32::from_le_bytes(*c)).collect())
+}
