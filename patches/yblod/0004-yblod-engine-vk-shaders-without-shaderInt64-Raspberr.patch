diff --git a/yblod-engine/vk/build.rs b/yblod-engine/vk/build.rs
index 104516c..7042b67 100644
--- a/yblod-engine/vk/build.rs
+++ b/yblod-engine/vk/build.rs
@@ -13,16 +13,22 @@ fn main() {
             continue;
         }
         let stem = path.file_stem().unwrap().to_str().unwrap().to_owned();
-        let spv = out.join(format!("{stem}.spv"));
-        let status = Command::new(&glslc)
-            .args(["--target-env=vulkan1.3", "-O", "-Werror", "-Ishaders/common"])
-            .arg(&path)
-            .arg("-o")
-            .arg(&spv)
-            .status()
-            .expect("run glslc (shaderc)");
-        assert!(status.success(), "glslc failed on {}", path.display());
-        names.push(stem);
+        // Each shader twice: native, and "@noi64" with 64-bit integers
+        // emulated on 32-bit pairs (DV_NO_INT64, dv_common.glsl) for devices
+        // without shaderInt64 (v3dv: the Raspberry Pi 5).
+        for (name, defines) in [(stem.clone(), &[][..]), (format!("{stem}@noi64"), &["-DDV_NO_INT64"][..])] {
+            let spv = out.join(format!("{name}.spv"));
+            let status = Command::new(&glslc)
+                .args(["--target-env=vulkan1.3", "-O", "-Werror", "-Ishaders/common"])
+                .args(defines)
+                .arg(&path)
+                .arg("-o")
+                .arg(&spv)
+                .status()
+                .expect("run glslc (shaderc)");
+            assert!(status.success(), "glslc failed on {} {defines:?}", path.display());
+            names.push(name);
+        }
     }
     names.sort();
     let mut table = String::from("pub static SHADERS: &[(&str, &[u8])] = &[\n");
diff --git a/yblod-engine/vk/shaders/common/dv_common.glsl b/yblod-engine/vk/shaders/common/dv_common.glsl
index efdbdf6..5bb8e6a 100644
--- a/yblod-engine/vk/shaders/common/dv_common.glsl
+++ b/yblod-engine/vk/shaders/common/dv_common.glsl
@@ -1,7 +1,62 @@
 // Shared helpers, 1:1 with yblod's opencl_kernels.cl. Integer only.
 #extension GL_EXT_shader_16bit_storage : require
 #extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+#ifndef DV_NO_INT64
 #extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
+#endif
+
+// 64-bit integer arithmetic. Native int64 by default; with DV_NO_INT64 (built
+// as each shader's "@noi64" variant, for devices without shaderInt64: v3dv,
+// the Raspberry Pi 5) a 64-bit value is uvec2(low word, high word), two's
+// complement, and these macros/functions give bit-identical results. Never
+// apply GLSL operators to an I64_T: on uvec2 they are component-wise.
+#ifdef DV_NO_INT64
+#define I64_T uvec2
+uvec2 i64_u32(uint u) { return uvec2(u, 0u); }
+uvec2 i64_i32(int s) { return uvec2(uint(s), s < 0 ? 0xffffffffu : 0u); }
+uvec2 i64_add(uvec2 a, uvec2 b) { uint c; uint lo = uaddCarry(a.x, b.x, c); return uvec2(lo, a.y + b.y + c); }
+bool i64_negative(uvec2 a) { return int(a.y) < 0; }
+// a * b mod 2^64, b zero-extended (int64 * int64_t(uint) in the native code).
+uvec2 i64_mul_u32(uvec2 a, uint b) { uint hi, lo; umulExtended(a.x, b, hi, lo); return uvec2(lo, hi + a.y * b); }
+// int64_t(int a) * int64_t(uint64_t(uint b)): exact (|a b| < 2^63).
+uvec2 i64_mul_i32_u32(int a, uint b) { uint hi, lo; umulExtended(uint(a), b, hi, lo); return uvec2(lo, hi - (a < 0 ? b : 0u)); }
+// int x int -> int64 (imulExtended, as packInt2x32 of it).
+uvec2 i64_mul_i32_i32(int a, int b) { int hi, lo; imulExtended(a, b, hi, lo); return uvec2(uint(lo), uint(hi)); }
+// min(uint64_t(a) >> shift, 65535) for a >= 0, 0 < shift < 64.
+uint i64_shr_min16(uvec2 a, uint shift)
+{
+    if (shift >= 32u)
+        return min(a.y >> (shift - 32u), 65535u);
+    if ((a.y >> shift) != 0u)
+        return 65535u;
+    return min((a.x >> shift) | (a.y << (32u - shift)), 65535u);
+}
+// uint((uint64_t(a) * uint64_t(b)) >> q), 0 < q < 64.
+uint u64_mulshr(uint a, uint b, uint q)
+{
+    uint hi, lo;
+    umulExtended(a, b, hi, lo);
+    return q >= 32u ? hi >> (q - 32u) : (lo >> q) | (hi << (32u - q));
+}
+#define ACC64(v, x) v = i64_add(v, x)
+#define SUM64(u, s) i64_add(i64_u32(u), i64_i32(s))
+#define WORDS64(lo, hi) uvec2(lo, hi)
+#define MUL64_I32_U32(a, b) i64_mul_i32_u32(a, b)
+#define MUL64_U32(a, b) i64_mul_u32(a, b)
+#define MAP16(v, shift) (i64_negative(v) ? 0u : i64_shr_min16(v, shift))
+#define SHR16_U64(lo, hi, shift) i64_shr_min16(uvec2(lo, hi), shift)
+#define MULSHR(a, b, q) u64_mulshr(a, b, q)
+#else
+#define I64_T int64_t
+#define ACC64(v, x) v += x
+#define SUM64(u, s) int64_t(u) + int64_t(s)
+#define WORDS64(lo, hi) int64_t((uint64_t(hi) << 32) | uint64_t(lo))
+#define MUL64_I32_U32(a, b) int64_t(a) * int64_t(uint64_t(b))
+#define MUL64_U32(a, b) a * int64_t(b)
+#define MAP16(v, shift) (v < 0 ? 0u : uint(min(uint64_t(v) >> shift, uint64_t(65535))))
+#define SHR16_U64(lo, hi, shift) uint(min(((uint64_t(hi) << 32) | uint64_t(lo)) >> shift, uint64_t(65535)))
+#define MULSHR(a, b, q) uint((uint64_t(a) * uint64_t(b)) >> q)
+#endif
 
 int edge(int p, uint n) { return clamp(p, 0, int(n) - 1); }
 
@@ -59,8 +114,21 @@ uvec2 phase_uv_sample(sampler2D src, uint x, int row, uint h, uint method)
 #endif
 
 // luma_equal/luma_pair's final step: Q16 mapping + residual -> 12-bit.
+#ifdef DV_NO_INT64
+// total > -8 ? (total + 8) / 16 : 0, clamped to 0..4095 (total + 8 > 0: a shift).
+uint recon12(uvec2 total)
+{
+    uvec2 s = i64_add(total, uvec2(8u, 0u));
+    if (i64_negative(s) || (s.x | s.y) == 0u)
+        return 0u;
+    return s.y != 0u ? 4095u : min(s.x >> 4, 4095u);
+}
+// Outside int32: the high word isn't the low word's sign extension.
+bool overflows32(uvec2 total) { return total.y != uint(int(total.x) >> 31); }
+#else
 uint recon12(int64_t total) { return uint(clamp(total > -8 ? (total + 8) / 16 : int64_t(0), int64_t(0), int64_t(4095))); }
 bool overflows32(int64_t total) { return total > int64_t(2147483647) || total < int64_t(-2147483647) - 1; }
+#endif
 
 // horizontal(): the EL's 8-tap 2x upsample (even samples passed through);
 // HORIZONTAL(name, buffer) defines one for a given source buffer.
