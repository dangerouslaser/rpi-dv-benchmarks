+// mmr64_dual_pixel one channel at a time (the narrow variant): channel c's
+// 64-bit MMR sum alone, features recomputed per channel. Exact integer sums,
+// so identical results; half the live 64-bit state (V3D: 4 threads).
+bool mmr64_channel(uvec3 s, uint P, uint T, uint el, uint channel, out uint value)
+{
+    I64_T v = constant64(P);
+    ACC64(v, table[T + s.x]); ACC64(v, table[T + 1024u + s.y]); ACC64(v, table[T + 2048u + s.z]);
+    uint xy = s.x * s.y;
+    [[dont_unroll]] for (uint k = 3; k < 7; k++) {
+        uint a = k == 3u ? xy : k == 4u ? s.x * s.z : k == 5u ? s.y * s.z : feature_product(xy, s.z << 10);
+        ACC64(v, term(p[P + 12 + 4 * k], a));
+        if (p[P] > 1u) {
+            uint b = feature_product(a, a);
+            ACC64(v, term(p[P + 40 + 4 * k], b));
+            if (p[P] > 2u) ACC64(v, term(p[P + 68 + 4 * k], feature_product(a, b)));
+        }
+    }
+    uint m = MAP16(v, p[P + 1] + 4u);
+    return recon32(m, rt[(1u + channel) * 1024u + el], value);
+}
+
+void mmr64_dual_pixel_sequential(uvec3 s, uvec2 enhancement, out uvec2 o, out bvec2 ok)
+{
+    // both channels take the guide clamped by channel 0's bounds, as mmr64_dual_pixel
+    s.x = clamp(s.x, p[2], p[3]);
+    s.y = clamp(s.y, p[4], p[5]);
+    s.z = clamp(s.z, p[6], p[7]);
+    [[dont_unroll]] for (uint channel = 0; channel < 2; ++channel) {
+        uint el = enhancement[channel];
+        if (el > 1023u) {               // reported, clamped
+            atomicOr(error, 1u);
+            el = 1023u;
+        }
+        uint value;
+        ok[channel] = mmr64_channel(s, channel * 96u, channel * 3072u, el, channel, value);
+        o[channel] = value;
+        if (!ok[channel])
+            atomicOr(error, 2u);
+    }
+}
+
 uint half16(uint d, uint k) { return k == 0u ? d & 0xffffu : d >> 16; }
 
