-// The FEL EL upscale (the push constant `nearest` carries it): 0 CCM Annex B
-// (Master Reference: 8-tap horizontal, 4-tap vertical), 1 nearest (2x2
-// replication), 2 bilinear (2-tap both ways, same siting as Annex B: EL
-// co-sited horizontally, rows at 1/4 and 3/4 vertically; the EL chroma keeps
-// Annex B's chroma phase filter and 64/192 vertical step, which is bilinear).
-const uint EL_ANNEXB = 0u, EL_NEAREST = 1u, EL_BILINEAR = 2u;
+// The FEL EL upscale (the push constant `nearest`, a historical name, carries
+// it): 0 CCM Annex B (Master Reference: 8-tap horizontal, 4-tap vertical), 2
+// bilinear (2-tap both ways, same siting as Annex B: EL co-sited horizontally,
+// rows at 1/4 and 3/4 vertically; the EL chroma keeps Annex B's chroma phase
+// filter and 64/192 vertical step, which is bilinear). Nearest (1) is gone:
+// the plan sends its requests to bilinear.
+const uint EL_ANNEXB = 0u, EL_BILINEAR = 2u;
 
 // A frame's uniform selector (EL filter, chroma method, MMR kinds, ...): a
 // specialization constant (ids 20.., gpu.rs SPEC_*) when the engine built a
@@ -165,13 +166,13 @@ uint bilinear_mid(uint a, uint b) { return (a + b + 1u) >> 1; }
 uint bilinear_quarter(uint near, uint far) { return (3u * near + far + 2u) >> 2; }
 
 // horizontal(): the EL's 2x upsample (even samples passed through; odd ones
-// 8-tap Annex B, 2-tap bilinear or nearest); HORIZONTAL(name, buffer) defines
-// one for a given source buffer.
+// 8-tap Annex B or 2-tap bilinear); HORIZONTAL(name, buffer) defines one for
+// a given source buffer.
 #define HORIZONTAL(NAME, BUF)                                                              \
     uint NAME(uint w, uint x, uint y, uint el_filter)                                        \
     {                                                                                      \
         uint ix = x / 2;                                                                   \
-        if ((x & 1u) == 0u || el_filter == EL_NEAREST)                                       \
+        if ((x & 1u) == 0u)                                                                \
             return uint(BUF[y * w + ix]);                                                  \
         if (el_filter == EL_BILINEAR)                                                        \
             return bilinear_mid(uint(BUF[y * w + ix]), uint(BUF[y * w + uint(edge(int(ix) + 1, w))])); \
