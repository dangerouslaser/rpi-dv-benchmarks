+    #[test]
+    fn nearest_requests_plan_bilinear() {
+        // el_scaler 0 (formerly nearest) plans exactly as 2 (bilinear),
+        // every fixture and configuration
+        let mut a = Plan::boxed();
+        let mut b = Plan::boxed();
+        for (name, has_el, _) in ROUTES {
+            let md = fixture(name);
+            for k in 0..6u32 {
+                let (mut input, desktop) = plan_in(has_el, k);
+                if input.el_scaler == 1 {
+                    continue; // Annex B configurations
+                }
+                input.el_scaler = 0;
+                let mut st = PlanState::new().unwrap();
+                assert_eq!(a.fill(&input, desktop.as_ref(), &mut st, &md), 0, "{name} config {k}");
+                input.el_scaler = 2;
+                let mut st = PlanState::new().unwrap();
+                assert_eq!(b.fill(&input, desktop.as_ref(), &mut st, &md), 0, "{name} config {k}");
+                assert_eq!(digest(&a), digest(&b), "{name} config {k}");
+            }
+        }
+    }
