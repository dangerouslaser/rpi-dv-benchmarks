 yblod-engine/vk/src/engine.rs     | 30 +++++++++++++++++++++++++-----
 yblod-engine/vk/src/gpu.rs        |  2 ++
 yblod-engine/vk/src/options.rs    |  5 +++++
 4 files changed, 44 insertions(+), 10 deletions(-)

