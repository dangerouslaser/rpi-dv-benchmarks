From b3cd6ce6481d80753fbcb637ba177a8302ec1ab9 Mon Sep 17 00:00:00 2001
From: Bryan Hoban <bryan.hoban@gmail.com>
Date: Fri, 6 Nov 2026 10:30:56 -0500
Subject: [PATCH 1/6] yblod-engine-vk: build on aarch64 (c_char is u8 there)

---
 yblod-engine/vk/src/device.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/yblod-engine/vk/src/device.rs b/yblod-engine/vk/src/device.rs
index 94a31b2..97fb246 100644
--- a/yblod-engine/vk/src/device.rs
+++ b/yblod-engine/vk/src/device.rs
@@ -209,7 +209,7 @@ impl Device {
         let priorities = [1.0f32];
         let queues =
             [vk::DeviceQueueCreateInfo::default().queue_family_index(queue_family).queue_priorities(&priorities)];
-        let mut ext_names: Vec<*const i8> = DEVICE_EXTENSIONS.iter().map(|e| e.as_ptr()).collect();
+        let mut ext_names: Vec<*const std::ffi::c_char> = DEVICE_EXTENSIONS.iter().map(|e| e.as_ptr()).collect();
         // Optional diagnostics only; never require this extension for playback.
         let calibrate = options.deadline_trace
             && exts.iter().any(|e| e.extension_name_as_c_str().ok() == Some(ext::calibrated_timestamps::NAME))
