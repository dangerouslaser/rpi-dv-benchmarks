+++ b/yblod-engine/vk/include/dv_engine_vk.h
@@ -115,6 +115,27 @@ int dvvk_drain(dvvk_engine *, uint64_t timeout_ns);
  * engines cannot reset successfully; destroy/recreate only after retirement. */
 int dvvk_reset_checked(dvvk_engine *, uint64_t timeout_ns);
 void dvvk_reset(dvvk_engine *);
+/* Decoders without VAAPI (the Raspberry Pi 5's V4L2 request HEVC decoder):
+ * create the engine with va_display NULL and register each decoded picture
+ * under the id its frames then name in bl_surface / el_surface. Registered
+ * pictures are re-checked every frame (re-register an id whenever its buffer
+ * changes; the fds are dup'd). Plane 0 luma, plane 1 chroma; formats:
+ *   DRM_FORMAT_P010 / NV12, LINEAR or a modifier Vulkan can import;
+ *   DRM_FORMAT_P030 with DRM_FORMAT_MOD_BROADCOM_SAND128_COL_HEIGHT(h): the
+ *   column height h for both planes on one object, or h = 0 with each plane's
+ *   column height in its pitch (one object each, V4L2 *_COL128M), as
+ *   FFmpeg's DRM PRIME descriptor gives them. Unpacked by the engine on the
+ *   GPU into P010-identical planes each frame.
+ * The caller hands over finished pictures (no VA sync without VA). */
+typedef struct {
+    uint32_t drm_format, width, height;   /* allocated size */
+    uint32_t num_objects;                 /* 1, or 2 (one per plane) */
+    int fd[2];
+    uint32_t size[2];
+    uint64_t modifier;
+    uint32_t object[2], offset[2], pitch[2];  /* per plane */
+} dvvk_surface_dmabuf;
+int dvvk_set_surface_dmabuf(dvvk_engine *, uint32_t id, const dvvk_surface_dmabuf *);
 /* Decoded surfaces are imported once and then known by their VASurfaceID
  * until a reset: reset whenever the decoder's surface pool changes (a new
  * AVHWFramesContext may reuse ids for other allocations), and keep the old
@@ -127,6 +148,10 @@ void dvvk_destroy(dvvk_engine *);
 #if UINTPTR_MAX == UINT64_MAX
 /* The layouts (LP64), as src/abi.rs asserts them for the Rust mirrors. */
 DVVK_STATIC_ASSERT(sizeof(dvvk_frame) == 200, "dvvk_frame layout");
+DVVK_STATIC_ASSERT(sizeof(dvvk_surface_dmabuf) == 64, "dvvk_surface_dmabuf layout");
+DVVK_STATIC_ASSERT(offsetof(dvvk_surface_dmabuf, fd) == 16, "dvvk_surface_dmabuf layout");
+DVVK_STATIC_ASSERT(offsetof(dvvk_surface_dmabuf, modifier) == 32, "dvvk_surface_dmabuf layout");
+DVVK_STATIC_ASSERT(offsetof(dvvk_surface_dmabuf, pitch) == 56, "dvvk_surface_dmabuf layout");
 DVVK_STATIC_ASSERT(offsetof(dvvk_frame, bl_surface) == 160, "dvvk_frame layout");
 DVVK_STATIC_ASSERT(offsetof(dvvk_frame, metadata) == 168, "dvvk_frame layout");
 DVVK_STATIC_ASSERT(offsetof(dvvk_frame, metadata_size) == 176, "dvvk_frame layout");
diff --git a/yblod-engine/vk/shaders/sand30_unpack.comp b/yblod-engine/vk/shaders/sand30_unpack.comp
new file mode 100644
index 0000000..b92892d
--- /dev/null
+++ b/yblod-engine/vk/shaders/sand30_unpack.comp
@@ -0,0 +1,54 @@
+#version 460
+// A decoded 10-bit SAND128 picture (DRM_FORMAT_P030 + BROADCOM_SAND128, the
+// Raspberry Pi 5 HEVC decoder's only 10-bit output) into the linear planes
+// every other pass reads: luma R16 and interleaved chroma RG16, each sample
+// value << 6, i.e. exactly the bits of the same picture exported as P010.
+//
+// SAND128: the plane is cut into 128-byte-wide columns stored one after the
+// other, each `colh` rows tall. P030 packs three 10-bit samples per 32-bit
+// word (bits 0-9, 10-19, 20-29), luma Y Y Y, chroma U V U / V U V. Sample n
+// of a row (luma x; chroma 2x + c) is in word n / 3 at bit (n % 3) * 10.
+// Same addressing as FFmpeg's av_rpi_sand30_to_planar_{y,c}16.
+layout(local_size_x = 16, local_size_y = 8) in;
+
+layout(binding = 0, std430) readonly buffer LumaSrc { uint luma_words[]; };
+layout(binding = 1, std430) readonly buffer ChromaSrc { uint chroma_words[]; };
+layout(binding = 2, r16) writeonly uniform image2D luma;
+layout(binding = 3, rg16) writeonly uniform image2D chroma;
+
+layout(push_constant) uniform Push {
+    uint width, height;          // luma size
+    uint luma_offset, chroma_offset;   // bytes into their buffers (column 0, row 0)
+    uint luma_colh, chroma_colh;       // column heights in rows
+};
+
+uint byte_address(uint base, uint colh, uint n, uint row)
+{
+    uint b = (n / 3u) * 4u;
+    return base + (b & 127u) + row * 128u + (b >> 7) * 128u * colh;
+}
+
+uint luma10(uint n, uint row)
+{
+    uint a = byte_address(luma_offset, luma_colh, n, row);
+    return (luma_words[a >> 2] >> ((n % 3u) * 10u)) & 0x3ffu;
+}
+
+uint chroma10(uint n, uint row)
+{
+    uint a = byte_address(chroma_offset, chroma_colh, n, row);
+    return (chroma_words[a >> 2] >> ((n % 3u) * 10u)) & 0x3ffu;
+}
+
+// UNORM16 store of an exact code: (v << 6) / 65535 rounds back to v << 6.
+float unorm16(uint v) { return float(v << 6) / 65535.0; }
+
+void main()
+{
+    uvec2 p = gl_GlobalInvocationID.xy;
+    if (p.x < width && p.y < height)
+        imageStore(luma, ivec2(p), vec4(unorm16(luma10(p.x, p.y)), 0.0, 0.0, 1.0));
+    if (p.x < width / 2u && p.y < height / 2u)
+        imageStore(chroma, ivec2(p),
+                   vec4(unorm16(chroma10(2u * p.x, p.y)), unorm16(chroma10(2u * p.x + 1u, p.y)), 0.0, 1.0));
+}
