+/// C mirror of dvvk_surface_dmabuf (include/dv_engine_vk.h).
+#[repr(C)]
+pub struct DvvkSurfaceDmabuf {
+    pub drm_format: u32,
+    pub width: u32,
+    pub height: u32,
+    pub num_objects: u32,
+    pub fd: [i32; 2],
+    pub size: [u32; 2],
+    pub modifier: u64,
+    pub object: [u32; 2],
+    pub offset: [u32; 2],
+    pub pitch: [u32; 2],
+}
+
+/// # Safety
+/// `e` from dvvk_create with a NULL va_display; `desc` valid (fds dup'd).
+#[no_mangle]
+pub unsafe extern "C" fn dvvk_set_surface_dmabuf(e: *mut Engine, id: u32, desc: *const DvvkSurfaceDmabuf) -> i32 {
+    let Some(s) = desc.as_ref() else {
+        return DVVK_INVALID;
+    };
+    if s.num_objects == 0 || s.num_objects > 2 {
+        return DVVK_INVALID;
+    }
+    let mut v = crate::interop::va::VADRMPRIMESurfaceDescriptor {
+        fourcc: s.drm_format,
+        width: s.width,
+        height: s.height,
+        num_objects: s.num_objects,
+        num_layers: 2,
+        ..Default::default()
+    };
+    for i in 0..s.num_objects as usize {
+        v.objects[i].fd = s.fd[i];
+        v.objects[i].size = s.size[i];
+        v.objects[i].drm_format_modifier = s.modifier;
+    }
+    for p in 0..2 {
+        v.layers[p].num_planes = 1;
+        v.layers[p].object_index[0] = s.object[p];
+        v.layers[p].offset[0] = s.offset[p];
+        v.layers[p].pitch[0] = s.pitch[p];
+    }
+    with_engine(e, "surface", DVVK_INVALID, DVVK_BACKEND, |e| match e.set_surface_dmabuf(id, &v) {
+        Ok(()) => 0,
+        Err(err) => {
+            log_error("surface", err);
+            DVVK_UNSUPPORTED
+        }
+    })
+}
+
 /// # Safety
 /// `e` from dvvk_create; `fd` a linear XRGB8888 3840x2160 dmabuf (dup'd).
 #[no_mangle]
