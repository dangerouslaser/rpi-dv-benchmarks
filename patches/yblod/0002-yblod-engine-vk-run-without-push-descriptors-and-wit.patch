+/// A decoded picture's planes made readable by this frame's compute: an
+/// imported surface is acquired from the decoder's (foreign) queue; a SAND128
+/// one has its buffers acquired and is unpacked into the engine's own planes.
+fn acquire_surface(
+    d: &Device,
+    cmd: vk::CommandBuffer,
+    s: &va::SurfaceImport,
+    sand_pipe: Option<&Pipeline>,
+    push: &PushDescriptor,
+) {
+    let Some(sand) = &s.sand else {
+        gpu::acquire_foreign_images(d, cmd, &[s.luma.image, s.chroma.image]);
+        return;
+    };
+    let pipe = sand_pipe.expect("sand30_unpack made with the first SAND picture");
+    let mut buffers = [vk::BufferMemoryBarrier2::default(); 2];
+    for (b, src) in buffers.iter_mut().zip(&sand.buffers) {
+        *b = vk::BufferMemoryBarrier2::default()
+            .src_stage_mask(vk::PipelineStageFlags2::NONE)
+            .dst_stage_mask(vk::PipelineStageFlags2::COMPUTE_SHADER)
+            .dst_access_mask(vk::AccessFlags2::SHADER_READ)
+            .src_queue_family_index(vk::QUEUE_FAMILY_FOREIGN_EXT)
+            .dst_queue_family_index(d.queue_family)
+            .buffer(src.buffer)
+            .offset(0)
+            .size(vk::WHOLE_SIZE);
+    }
+    let range = vk::ImageSubresourceRange {
+        aspect_mask: vk::ImageAspectFlags::COLOR,
+        base_mip_level: 0,
+        level_count: 1,
+        base_array_layer: 0,
+        layer_count: 1,
+    };
+    // Earlier frames' reads of these planes are done before they're rewritten.
+    let to_write = [s.luma.image, s.chroma.image].map(|image| {
