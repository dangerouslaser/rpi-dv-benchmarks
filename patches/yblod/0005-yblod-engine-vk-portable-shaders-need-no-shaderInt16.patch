From a518d010d395203f1cc5d67895a90def244a2689 Mon Sep 17 00:00:00 2001
From: Bryan Hoban <bryan.hoban@gmail.com>
Date: Fri, 6 Nov 2026 11:47:52 -0500
Subject: [PATCH 5/5] yblod-engine-vk: portable shaders need no shaderInt16
 either

Mesa 25.0.7 (Raspberry Pi OS trixie) reports shaderInt16 = false on the
Pi 5 (enabled for V3D 7.1 only in later Mesa). The @noi64 build now also
avoids 16-bit arithmetic (16-bit storage remains, which v3dv has): two
16-bit locals become 32-bit (LOCAL_U16), and the int16 extension is off in
that build so any new use fails to compile. The device needs neither
feature; the native shaders are used only with both. Native SPIR-V still
byte-identical; outputs identical on lavapipe.
---
 yblod-engine/vk/shaders/common/dv_common.glsl | 10 +++++++++-
 yblod-engine/vk/shaders/fel_chroma.comp       |  4 ++--
 .../vk/shaders/fel_vertical_pair.comp         |  6 +++---
 yblod-engine/vk/src/device.rs                 | 19 +++++++++++--------
 4 files changed, 25 insertions(+), 14 deletions(-)

diff --git a/yblod-engine/vk/shaders/common/dv_common.glsl b/yblod-engine/vk/shaders/common/dv_common.glsl
index 5bb8e6a..517cbdd 100644
--- a/yblod-engine/vk/shaders/common/dv_common.glsl
+++ b/yblod-engine/vk/shaders/common/dv_common.glsl
@@ -1,9 +1,17 @@
 // Shared helpers, 1:1 with yblod's opencl_kernels.cl. Integer only.
 #extension GL_EXT_shader_16bit_storage : require
-#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
 #ifndef DV_NO_INT64
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
 #extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
 #endif
+// DV_NO_INT64 also builds without 16-bit arithmetic (shaderInt16): Mesa 25.0's
+// v3dv (Raspberry Pi OS trixie) has neither. 16-bit storage stays: values
+// are 32-bit in registers and converted on load/store (LOCAL_U16).
+#ifdef DV_NO_INT64
+#define LOCAL_U16 uint
+#else
+#define LOCAL_U16 uint16_t
+#endif
 
 // 64-bit integer arithmetic. Native int64 by default; with DV_NO_INT64 (built
 // as each shader's "@noi64" variant, for devices without shaderInt64: v3dv,
diff --git a/yblod-engine/vk/shaders/fel_chroma.comp b/yblod-engine/vk/shaders/fel_chroma.comp
index 7730fb9..80f835a 100644
--- a/yblod-engine/vk/shaders/fel_chroma.comp
+++ b/yblod-engine/vk/shaders/fel_chroma.comp
@@ -205,7 +205,7 @@ void main()
             atomicOr(error, 2u);
             continue;
         }
-        uint16_t value = uint16_t(recon12(total));
-        if (channel != 0u) out1[i] = value; else out0[i] = value;
+        LOCAL_U16 value = LOCAL_U16(recon12(total));
+        if (channel != 0u) out1[i] = uint16_t(value); else out0[i] = uint16_t(value);
     }
 }
diff --git a/yblod-engine/vk/shaders/fel_vertical_pair.comp b/yblod-engine/vk/shaders/fel_vertical_pair.comp
index f0fe62f..803dc72 100644
--- a/yblod-engine/vk/shaders/fel_vertical_pair.comp
+++ b/yblod-engine/vk/shaders/fel_vertical_pair.comp
@@ -15,9 +15,9 @@ void main()
     if (x >= w || y >= h)
         return;
     if (nearest != 0u) {
-        uint16_t v = uint16_t(input_sample(src, x, y, channel));
-        dst[y * 2 * w + x] = v;
-        dst[(y * 2 + 1) * w + x] = v;
+        LOCAL_U16 v = LOCAL_U16(input_sample(src, x, y, channel));
+        dst[y * 2 * w + x] = uint16_t(v);
+        dst[(y * 2 + 1) * w + x] = uint16_t(v);
         return;
     }
     int s0 = int(input_sample(src, x, uint(edge(int(y) - 2, h)), channel));
diff --git a/yblod-engine/vk/src/device.rs b/yblod-engine/vk/src/device.rs
index 0db6d30..2e67bfe 100644
--- a/yblod-engine/vk/src/device.rs
+++ b/yblod-engine/vk/src/device.rs
@@ -60,7 +60,8 @@ pub struct Device {
     /// VK_KHR_push_descriptor enabled; otherwise gpu::PushDescriptor binds
     /// descriptor sets from per-command-buffer pools.
     pub push_descriptor: bool,
-    /// shaderInt64 enabled; otherwise every pipeline uses its "@noi64" SPIR-V.
+    /// The native shaders (shaderInt64 + shaderInt16 enabled); otherwise every
+    /// pipeline uses its "@noi64" SPIR-V, which needs neither.
     pub int64: bool,
     /// DVVK_SUBGROUP=N: the subgroup (SIMD) width every compute pipeline is
     /// created with, when the device can require it (0: the driver's choice).
@@ -147,17 +148,19 @@ impl Device {
         let mut f13 = vk::PhysicalDeviceVulkan13Features::default();
         let mut f = vk::PhysicalDeviceFeatures2::default().push_next(&mut f11).push_next(&mut f12).push_next(&mut f13);
         unsafe { instance.get_physical_device_features2(physical, &mut f) };
-        // shaderInt64 optional (v3dv has none): the @noi64 shaders instead.
-        let int64 = f.features.shader_int64 != 0 && !options.no_int64;
-        let have = f.features.shader_int16 != 0
-            && f11.storage_buffer16_bit_access != 0
+        // The native shaders need shaderInt64 and shaderInt16; without either
+        // (v3dv: no int64 at all, no int16 before Mesa 25.1) the "@noi64"
+        // build, which needs neither.
+        let int16 = f.features.shader_int16 != 0;
+        let int64 = f.features.shader_int64 != 0 && int16 && !options.no_int64;
+        let have = f11.storage_buffer16_bit_access != 0
             && f12.storage_buffer8_bit_access != 0
             && f12.timeline_semaphore != 0
             && f13.synchronization2 != 0
             && f13.maintenance4 != 0;
         if !have {
             return Err(Error::Unsupported(
-                "int16, 8/16-bit storage, timeline semaphores, sync2, maintenance4".into(),
+                "8/16-bit storage, timeline semaphores, sync2, maintenance4".into(),
             ));
         }
 
@@ -167,9 +170,9 @@ impl Device {
             .position(|q| q.queue_flags.contains(vk::QueueFlags::COMPUTE))
             .ok_or(Error::Missing("a compute queue"))? as u32;
 
-        let features = vk::PhysicalDeviceFeatures::default().shader_int64(int64).shader_int16(true);
+        let features = vk::PhysicalDeviceFeatures::default().shader_int64(int64).shader_int16(int64);
         if !int64 {
-            eprintln!("dv-engine-vk: no shaderInt64: 64-bit integer maths emulated in the shaders");
+            eprintln!("dv-engine-vk: portable shaders (no shaderInt64/shaderInt16 use): 64-bit maths emulated");
         }
         let mut e11 = vk::PhysicalDeviceVulkan11Features::default().storage_buffer16_bit_access(true);
         let mut e12 = vk::PhysicalDeviceVulkan12Features::default()
