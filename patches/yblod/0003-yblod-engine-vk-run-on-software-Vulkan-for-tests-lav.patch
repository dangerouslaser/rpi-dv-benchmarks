From ad00e43e3503a8a10ca5ecb1f3fe60c12af3e6b8 Mon Sep 17 00:00:00 2001
From: Bryan Hoban <bryan.hoban@gmail.com>
Date: Fri, 6 Nov 2026 10:57:09 -0500
Subject: [PATCH 3/5] yblod-engine-vk: run on software Vulkan for tests
 (lavapipe)

- drm_fd < 0: no DRM node; the first device (DVVK_DEVICE: name filter).
- VK_KHR_external_semaphore_fd optional: without it outputs carry no
  implicit fence and the caller waits for each ticket (implicit_failed),
  as with a kernel that can't attach sync files.
---
 yblod-engine/vk/src/device.rs       | 23 +++++++++++++++++------
 yblod-engine/vk/src/engine.rs       | 24 ++++++++++++++++--------
 yblod-engine/vk/src/interop/sync.rs | 14 ++++++++++----
 3 files changed, 43 insertions(+), 18 deletions(-)

diff --git a/yblod-engine/vk/src/device.rs b/yblod-engine/vk/src/device.rs
index dd3e196..e23f34a 100644
--- a/yblod-engine/vk/src/device.rs
+++ b/yblod-engine/vk/src/device.rs
@@ -37,7 +37,6 @@ const DEVICE_EXTENSIONS: &[&CStr] = &[
     khr::external_memory_fd::NAME,
     ext::external_memory_dma_buf::NAME,
     ext::image_drm_format_modifier::NAME,
-    khr::external_semaphore_fd::NAME,
     ext::queue_family_foreign::NAME,
 ];
 
@@ -50,7 +49,9 @@ pub struct Device {
     pub queue_family: u32,
     pub memory: vk::PhysicalDeviceMemoryProperties,
     pub memory_fd: khr::external_memory_fd::Device,
-    pub semaphore_fd: khr::external_semaphore_fd::Device,
+    /// None without VK_KHR_external_semaphore_fd (lavapipe): no implicit
+    /// fences on outputs, the caller waits for each ticket (implicit_failed).
+    pub semaphore_fd: Option<khr::external_semaphore_fd::Device>,
     pub modifier: ext::image_drm_format_modifier::Device,
     pub name: String,
     pub driver: String,
@@ -84,7 +85,9 @@ pub fn drm_node(fd: i32) -> Result<(i64, i64)> {
 impl Device {
     /// The Vulkan device for this DRM fd (render or primary node).
     pub fn new(drm_fd: i32, options: crate::options::EngineOptions) -> Result<Self> {
-        let node = drm_node(drm_fd)?;
+        // drm_fd < 0: no DRM node (software Vulkan, e.g. lavapipe in tests):
+        // the first device whose name contains DVVK_DEVICE (default: any).
+        let node = if drm_fd < 0 { (-1, -1) } else { drm_node(drm_fd)? };
         let entry = unsafe { ash::Entry::load() }.map_err(|e| Error::Load(e.to_string()))?;
         let app = vk::ApplicationInfo::default().application_name(c"dv-engine-vk").api_version(vk::API_VERSION_1_3);
         let instance =
@@ -111,7 +114,7 @@ impl Device {
             let mut props = vk::PhysicalDeviceProperties2::default().push_next(&mut drm).push_next(&mut driver);
             let exts = unsafe { instance.enumerate_device_extension_properties(pd) }?;
             let has_drm = exts.iter().any(|e| e.extension_name_as_c_str().ok() == Some(ext::physical_device_drm::NAME));
-            if !has_drm {
+            if !has_drm && node.0 >= 0 {
                 continue;
             }
             unsafe { instance.get_physical_device_properties2(pd, &mut props) };
@@ -120,7 +123,8 @@ impl Device {
             let _ = props;
             let primary = drm.has_primary != 0 && (drm.primary_major, drm.primary_minor) == node;
             let render = drm.has_render != 0 && (drm.render_major, drm.render_minor) == node;
-            if primary || render {
+            let by_name = node.0 < 0 && std::env::var("DVVK_DEVICE").map_or(true, |want| name.contains(&want));
+            if primary || render || by_name {
                 let drv = driver.driver_info_as_c_str().unwrap_or(c"?").to_string_lossy().into_owned();
                 chosen = Some((pd, name, drv, period));
                 break;
@@ -229,6 +233,13 @@ impl Device {
         if push_descriptor {
             ext_names.push(khr::push_descriptor::NAME.as_ptr());
         }
+        let semaphore_fd =
+            exts.iter().any(|e| e.extension_name_as_c_str().ok() == Some(khr::external_semaphore_fd::NAME));
+        if semaphore_fd {
+            ext_names.push(khr::external_semaphore_fd::NAME.as_ptr());
+        } else {
+            eprintln!("dv-engine-vk: no VK_KHR_external_semaphore_fd: outputs carry no implicit fence");
+        }
         let info = vk::DeviceCreateInfo::default()
             .queue_create_infos(&queues)
             .enabled_extension_names(&ext_names)
@@ -269,7 +280,7 @@ impl Device {
             calibration: calibrate.then(|| ext::calibrated_timestamps::Device::new(&instance, &device)),
             push_descriptor,
             memory_fd: khr::external_memory_fd::Device::new(&instance, &device),
-            semaphore_fd: khr::external_semaphore_fd::Device::new(&instance, &device),
+            semaphore_fd: semaphore_fd.then(|| khr::external_semaphore_fd::Device::new(&instance, &device)),
             modifier: ext::image_drm_format_modifier::Device::new(&instance, &device),
             entry,
             instance,
diff --git a/yblod-engine/vk/src/engine.rs b/yblod-engine/vk/src/engine.rs
index a2c44d5..feadc33 100644
--- a/yblod-engine/vk/src/engine.rs
+++ b/yblod-engine/vk/src/engine.rs
@@ -1146,12 +1146,11 @@ impl Engine {
             vk::SemaphoreTypeCreateInfo::default().semaphore_type(vk::SemaphoreType::TIMELINE).initial_value(0);
         let mut export =
             vk::ExportSemaphoreCreateInfo::default().handle_types(vk::ExternalSemaphoreHandleTypeFlags::OPAQUE_FD);
-        let timeline = unsafe {
-            d.device.create_semaphore(
-                &vk::SemaphoreCreateInfo::default().push_next(&mut type_info).push_next(&mut export),
-                None,
-            )
-        }?;
+        let mut timeline_info = vk::SemaphoreCreateInfo::default().push_next(&mut type_info);
+        if d.semaphore_fd.is_some() {
+            timeline_info = timeline_info.push_next(&mut export);
+        }
+        let timeline = unsafe { d.device.create_semaphore(&timeline_info, None) }?;
         construction.watch(&timeline);
         if crate::fault::hit("construct-final") {
             return Err(Error::Vk(vk::Result::ERROR_UNKNOWN));
@@ -1530,7 +1529,8 @@ impl Engine {
             let info = vk::SemaphoreGetFdInfoKHR::default()
                 .semaphore(s)
                 .handle_type(vk::ExternalSemaphoreHandleTypeFlags::OPAQUE_FD);
-            Ok(unsafe { self.d.semaphore_fd.get_semaphore_fd(&info) }?)
+            let fd_api = self.d.semaphore_fd.as_ref().ok_or(Error::Missing("VK_KHR_external_semaphore_fd"))?;
+            Ok(unsafe { fd_api.get_semaphore_fd(&info) }?)
         };
         if self.release.is_none() {
             let mut type_info =
@@ -2506,11 +2506,15 @@ impl Engine {
                 .semaphore(self.ring[ci].done)
                 .stage_mask(vk::PipelineStageFlags2::ALL_COMMANDS),
         ];
+        // Without sync_file export the done semaphore is never waited on, so
+        // it is never signalled either (a binary semaphore can't be re-signalled).
+        let exporting = d.semaphore_fd.is_some();
+        let signal_infos = &signal_infos[..if exporting { 2 } else { 1 }];
         let cmds = [vk::CommandBufferSubmitInfo::default().command_buffer(cmd)];
         let submit = [vk::SubmitInfo2::default()
             .wait_semaphore_infos(wait_infos)
             .command_buffer_infos(&cmds)
-            .signal_semaphore_infos(&signal_infos)];
+            .signal_semaphore_infos(signal_infos)];
         if let Some(t) = self.ring[ci].deadline.as_mut() {
             t.release_ready = self
                 .release
@@ -2530,6 +2534,10 @@ impl Engine {
         self.ticket = ticket;
         // queue_submit2 succeeded: retain the context even if FD export fails.
         self.ring[ci].ticket = ticket;
+        if !exporting {
+            self.implicit_failed = true;
+            return Ok(ticket);
+        }
         // The frame's fence on the output dmabuf: the compositor (KWin waits
         // for a committed buffer's implicit fences) and KMS see it as written
         // only when it is.
diff --git a/yblod-engine/vk/src/interop/sync.rs b/yblod-engine/vk/src/interop/sync.rs
index 3fa0148..456d066 100644
--- a/yblod-engine/vk/src/interop/sync.rs
+++ b/yblod-engine/vk/src/interop/sync.rs
@@ -59,7 +59,8 @@ pub fn semaphore_from_sync_file(d: &Device, semaphore: vk::Semaphore, sync_file:
         .flags(vk::SemaphoreImportFlags::TEMPORARY)
         .handle_type(vk::ExternalSemaphoreHandleTypeFlags::SYNC_FD)
         .fd(sync_file);
-    unsafe { d.semaphore_fd.import_semaphore_fd(&info) }?;
+    let fd_api = d.semaphore_fd.as_ref().ok_or(Error::Missing("VK_KHR_external_semaphore_fd"))?;
+    unsafe { fd_api.import_semaphore_fd(&info) }?;
     Ok(())
 }
 
@@ -68,14 +69,19 @@ pub fn sync_file_from_semaphore(d: &Device, semaphore: vk::Semaphore) -> Result<
     let info = vk::SemaphoreGetFdInfoKHR::default()
         .semaphore(semaphore)
         .handle_type(vk::ExternalSemaphoreHandleTypeFlags::SYNC_FD);
-    Ok(unsafe { d.semaphore_fd.get_semaphore_fd(&info) }?)
+    let fd_api = d.semaphore_fd.as_ref().ok_or(Error::Missing("VK_KHR_external_semaphore_fd"))?;
+    Ok(unsafe { fd_api.get_semaphore_fd(&info) }?)
 }
 
-/// A binary semaphore that can export/import sync_files.
+/// A binary semaphore that can export/import sync_files (a plain one where
+/// the device can't).
 pub fn exportable_semaphore(d: &Device) -> Result<vk::Semaphore> {
     let mut export =
         vk::ExportSemaphoreCreateInfo::default().handle_types(vk::ExternalSemaphoreHandleTypeFlags::SYNC_FD);
-    let info = vk::SemaphoreCreateInfo::default().push_next(&mut export);
+    let mut info = vk::SemaphoreCreateInfo::default();
+    if d.semaphore_fd.is_some() {
+        info = info.push_next(&mut export);
+    }
     Ok(unsafe { d.device.create_semaphore(&info, None) }?)
 }
 
