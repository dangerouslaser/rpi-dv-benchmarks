+// The sited 4:2:0 pack's chroma (cb, cr) for an output row of parity `rp`
+// (ly & 1) from a chroma column's rows k-3 .. k+4 (k = ly / 2): CB1's Annex B
+// filters or the 2-tap blend. Computed per block right after the rows are
+// fetched, so only these results (not the 8 rows) stay live through the
+// pixel loop: register pressure (V3D: threads per QPU).
+uvec2 sited_chroma(uvec2 chroma_rows[8], uint rp)
+{
+    uvec2 out_c;
+    for (uint ch = 0; ch < 2; ch++) {
+        int r[8];
+        for (uint i = 0; i < 8; i++)
+            r[i] = int(ch != 0u ? chroma_rows[i].y : chroma_rows[i].x);
+        uint c;
+        if (chroma_filter != 0u) {
+            // CB1 (ETSI GS CCM 001 Annex B): left sited, the six-tap phases;
+            // top-left, aligned rows copied and the half-phase eight-tap
+            // between them. Clipped to the 12-bit code range.
+            int s;
+            if (top_left != 0u) {
+                s = rp == 0u ? r[3] << 12 :
+                    22 * (r[0] + r[7]) + 94 * (r[1] + r[6]) - 524 * (r[2] + r[5]) + 2456 * (r[3] + r[4]);
+                s = (s + 2048) >> 12;
+            } else {
+                s = rp == 0u ? 2 * r[0] - 12 * r[1] + 65 * r[2] + 222 * r[3] - 25 * r[4] + 4 * r[5]
+                             : 4 * r[1] - 25 * r[2] + 222 * r[3] + 65 * r[4] - 12 * r[5] + 2 * r[6];
+                s = (s + 128) >> 8;
+            }
+            c = uint(clamp(s, 0, 4095));
+        } else {
+            // rows k-1, k, k+1 (r[2..4]); sited weights as source_tunnel
+            uint lo, hi, a;
+            if (rp == 0u) { lo = 2u; hi = 3u; a = 1u; } else { lo = 3u; hi = 4u; a = 3u; }
+            if (top_left != 0u) { lo = 3u; hi = 4u; a = rp != 0u ? 2u : 4u; }
+            c = (a * uint(r[lo]) + (4 - a) * uint(r[hi]) + 2) / 4;
+        }
+        out_c[ch] = c;
+    }
+    return out_c;
+}
