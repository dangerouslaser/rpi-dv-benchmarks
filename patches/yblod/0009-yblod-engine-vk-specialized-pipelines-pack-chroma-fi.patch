+/// The specialized-variant cache key: the shader and every constant.
+fn variant_key(generic: &Pipeline, extra: &[(u32, u32)]) -> (String, Vec<(u32, u32)>) {
+    let mut spec = generic.spec.clone();
+    spec.extend_from_slice(extra);
+    (generic.shader.clone(), spec)
+}
+
+/// The plan fields that pick pipelines and their specializations.
+#[derive(Clone, Copy, Debug)]
+struct PlanSelectors {
+    route: u32,
+    equal: u32,
+    nearest: u32,
+    pack: u32,
+    chroma_filter: u32,
+    top_left: u32,
+    chroma_phase: u32,
+    dual: u32,
+    chroma_kind: [u32; 2],
+}
+
+impl PlanSelectors {
+    fn of(p: &Plan) -> Self {
+        PlanSelectors {
+            route: p.route,
+            equal: p.equal,
+            nearest: p.nearest,
+            pack: p.pack,
+            chroma_filter: p.chroma_filter,
+            top_left: p.top_left,
+            chroma_phase: p.chroma_phase,
+            dual: p.dual,
+            chroma_kind: p.chroma_kind,
+        }
+    }
+    fn route(&self) -> PackRoute {
+        PackRoute {
+            route: self.route,
+            equal: self.equal,
+            nearest: self.nearest,
+            pack: self.pack,
+            chroma_filter: self.chroma_filter,
+        }
+    }
+}
+
+/// Each pipeline's frame selectors as specialization constants (shaders:
+/// SPEC_OR_PUSH, the same values the push constants carry).
+fn pack_spec(p: &PlanSelectors) -> Vec<(u32, u32)> {
+    vec![(gpu::SPEC_EL_FILTER, p.nearest), (gpu::SPEC_TOP_LEFT, p.top_left), (gpu::SPEC_CHROMA_FILTER, p.chroma_filter)]
+}
+fn fel_chroma_spec(p: &PlanSelectors) -> Vec<(u32, u32)> {
+    vec![
+        (gpu::SPEC_EL_FILTER, p.nearest),
+        (gpu::SPEC_METHOD, p.chroma_phase),
+        (gpu::SPEC_DUAL, p.dual),
+        (gpu::SPEC_KIND0, p.chroma_kind[0]),
+        (gpu::SPEC_KIND1, p.chroma_kind[1]),
+    ]
+}
+fn luma_phase_guide_spec(p: &PlanSelectors) -> Vec<(u32, u32)> {
+    vec![(gpu::SPEC_EL_FILTER, p.nearest), (gpu::SPEC_METHOD, p.chroma_phase)]
+}
+fn mmr_dual_spec(p: &PlanSelectors) -> Vec<(u32, u32)> {
+    vec![(gpu::SPEC_EL_FILTER, p.nearest)]
+}
