From 7c1e5e6dd2bced1c6a332c7b2057033ebb0d4a4f Mon Sep 17 00:00:00 2001
From: Bryan Hoban <bryan.hoban@gmail.com>
Date: Fri, 6 Nov 2026 15:08:55 -0500
Subject: [PATCH 11/14] yblod-engine-vk: DVVK_ANNEXB_TILE=0 (no shared-memory
 chroma tile)

CB1's Annex B 4:2:2 filter in the fused single-layer pack reads its chroma
rows through a workgroup tile in shared memory. V3D has no on-chip shared
memory (load/store_shared are TMU accesses), so whether the tile pays there
is a measurement: DVVK_ANNEXB_TILE=0 selects the regular fused pack, which
filters the same rows itself. Identical output either way. The specialized
variant log line names its base pipeline's constants.
---
 yblod-engine/vk/src/engine.rs  | 18 +++++++++++++-----
 yblod-engine/vk/src/options.rs |  5 +++++
 2 files changed, 18 insertions(+), 5 deletions(-)

diff --git a/yblod-engine/vk/src/engine.rs b/yblod-engine/vk/src/engine.rs
index d9a5537..0ba6fd9 100644
--- a/yblod-engine/vk/src/engine.rs
+++ b/yblod-engine/vk/src/engine.rs
@@ -158,8 +158,15 @@ fn pack_source(r: &PackRoute) -> u32 {
 /// The frame's source and pack variant for overlay kind `overlay` (0 none,
 /// 1 prepared, 2 fused shell, 3 native CB1).
 fn select_pack(r: &PackRoute, overlay: u32) -> (u32, PackVariant) {
+    select_pack_with(r, overlay, true)
+}
+
+/// select_pack, with CB1's Annex B chroma tile variant allowed or not
+/// (DVVK_ANNEXB_TILE=0: the regular fused pack filters the same rows itself;
+/// V3D has no on-chip shared memory, so the tile's worth there is measured).
+fn select_pack_with(r: &PackRoute, overlay: u32, annexb_tile: bool) -> (u32, PackVariant) {
     let source = pack_source(r);
-    if r.chroma_filter != 0 && r.pack == plan::PACK_SITED && source == 1 {
+    if annexb_tile && r.chroma_filter != 0 && r.pack == plan::PACK_SITED && source == 1 {
         if let Some(k) = ANNEXB_OVERLAYS.iter().position(|&o| o == overlay) {
             return (source, PackVariant::Annexb(k));
         }
@@ -1835,8 +1842,9 @@ impl Engine {
             let made = generic.specialize(&self.d, &extra);
             if self.d.options.pipeline_profile || made.is_err() {
                 eprintln!(
-                    "dvvk specialized: {} {extra:?} {} in {:.1} ms",
+                    "dvvk specialized: {} {:?} + {extra:?} {} in {:.1} ms",
                     key.0,
+                    generic.spec,
                     if made.is_ok() { "made" } else { "FAILED (generic used)" },
                     start.elapsed().as_secs_f64() * 1e3
                 );
@@ -1859,7 +1867,7 @@ impl Engine {
 
     fn ensure_variants_for(&mut self, plan: &PlanSelectors) {
         let overlay = self.pack_overlay();
-        let variant = select_pack(&plan.route(), overlay).1;
+        let variant = select_pack_with(&plan.route(), overlay, self.d.options.annexb_tile).1;
         self.ensure_variant(
             move |e: &Engine| match variant {
                 PackVariant::Annexb(i) => Some(&e.pack_annexb[i]),
@@ -1931,7 +1939,7 @@ impl Engine {
 
     fn ensure_pack(&mut self) -> Result<()> {
         let overlay = self.pack_overlay();
-        let (source, index) = match select_pack(&PackRoute::of(&self.plan), overlay) {
+        let (source, index) = match select_pack_with(&PackRoute::of(&self.plan), overlay, self.d.options.annexb_tile) {
             (source, PackVariant::Regular(index)) => (source, index),
             _ => return Ok(()),
         };
@@ -2620,7 +2628,7 @@ impl Engine {
             }
             _ => bl.luma.view, // unused: a valid view to bind
         };
-        let variant = select_pack(&PackRoute::of(p), overlay_kind).1;
+        let variant = select_pack_with(&PackRoute::of(p), overlay_kind, self.d.options.annexb_tile).1;
         let pack = match variant {
             PackVariant::Annexb(i) => &self.pack_annexb[i],
             PackVariant::Regular(i) => match self.pack[i].as_ref() {
diff --git a/yblod-engine/vk/src/options.rs b/yblod-engine/vk/src/options.rs
index d7e5d24..9557036 100644
--- a/yblod-engine/vk/src/options.rs
+++ b/yblod-engine/vk/src/options.rs
@@ -73,6 +73,9 @@ pub struct EngineOptions {
     /// (fewer live registers; V3D: more threads). Default: on with the
     /// portable shaders (GPUs without shaderInt64, e.g. the Pi 5).
     pub narrow: Option<bool>,
+    /// DVVK_ANNEXB_TILE=0: no shared-memory chroma tile for CB1's Annex B
+    /// filter in the fused single-layer pack (the regular variant instead).
+    pub annexb_tile: bool,
     pub resize_fma: u32,
     pub blend_fma: u32,
     pub lazy_resized_pack: bool,
@@ -104,6 +107,7 @@ impl Default for EngineOptions {
             specialize: true,
             prepare_variants: false,
             narrow: None,
+            annexb_tile: true,
             resize_fma: 1,
             blend_fma: 1,
             lazy_resized_pack: false,
@@ -137,6 +141,7 @@ impl EngineOptions {
             specialize: not_zero("DVVK_SPECIALIZE"),
             prepare_variants: flag("DVVK_PREPARE_VARIANTS"),
             narrow: var("DVVK_NARROW").map(|v| v == "1"),
+            annexb_tile: not_zero("DVVK_ANNEXB_TILE"),
             resize_fma: number("DVVK_RESIZE_FMA", 1),
             blend_fma: number("DVVK_BLEND_FMA", 1),
             lazy_resized_pack: flag("DVVK_LAZY_RESIZED_PACK"),
