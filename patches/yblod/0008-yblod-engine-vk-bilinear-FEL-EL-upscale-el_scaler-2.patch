index 795097b..cf295b1 100644
--- a/yblod-engine/vk/shaders/common/dv_common.glsl
+++ b/yblod-engine/vk/shaders/common/dv_common.glsl
@@ -147,14 +147,28 @@ uint recon12(int64_t total) { return uint(clamp(total > -8 ? (total + 8) / 16 :
