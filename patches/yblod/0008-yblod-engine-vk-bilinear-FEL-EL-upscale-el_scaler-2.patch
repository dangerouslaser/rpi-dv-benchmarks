 #endif
 
-// horizontal(): the EL's 8-tap 2x upsample (even samples passed through);
-// HORIZONTAL(name, buffer) defines one for a given source buffer.
+// The FEL EL upscale (the push constant `nearest` carries it): 0 CCM Annex B
+// (Master Reference: 8-tap horizontal, 4-tap vertical), 1 nearest (2x2
+// replication), 2 bilinear (2-tap both ways, same siting as Annex B: EL
+// co-sited horizontally, rows at 1/4 and 3/4 vertically; the EL chroma keeps
+// Annex B's chroma phase filter and 64/192 vertical step, which is bilinear).
+const uint EL_ANNEXB = 0u, EL_NEAREST = 1u, EL_BILINEAR = 2u;
+// Bilinear 2x, exactly Annex B's rounding with taps {2048, 2048} / 4096 and
+// {32, 96} / 128: round half up.
+uint bilinear_mid(uint a, uint b) { return (a + b + 1u) >> 1; }
+uint bilinear_quarter(uint near, uint far) { return (3u * near + far + 2u) >> 2; }
+
+// horizontal(): the EL's 2x upsample (even samples passed through; odd ones
+// 8-tap Annex B, 2-tap bilinear or nearest); HORIZONTAL(name, buffer) defines
+// one for a given source buffer.
 #define HORIZONTAL(NAME, BUF)                                                              \
     uint NAME(uint w, uint x, uint y, uint nearest)                                        \
     {                                                                                      \
         uint ix = x / 2;                                                                   \
-        if ((x & 1u) == 0u || nearest != 0u)                                               \
+        if ((x & 1u) == 0u || nearest == EL_NEAREST)                                       \
             return uint(BUF[y * w + ix]);                                                  \
+        if (nearest == EL_BILINEAR)                                                        \
+            return bilinear_mid(uint(BUF[y * w + ix]), uint(BUF[y * w + uint(edge(int(ix) + 1, w))])); \
         const int taps[8] = int[8](22, 94, -524, 2456, 2456, -524, 94, 22);                \
         int v = 0;                                                                         \
         for (int k = 0; k < 8; k++)                                                        \
