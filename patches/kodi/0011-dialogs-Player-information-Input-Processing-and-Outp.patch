+}
+
+#include <drm_fourcc.h>
+
+namespace
+{
+// a 12-bit PQ code value, as the RPU's levels carry them
+double PQToNits(unsigned int code)
+{
+  constexpr double m1 = 2610.0 / 16384.0;
+  constexpr double m2 = 2523.0 / 4096.0 * 128.0;
+  constexpr double c1 = 3424.0 / 4096.0;
+  constexpr double c2 = 2413.0 / 4096.0 * 32.0;
+  constexpr double c3 = 2392.0 / 4096.0 * 32.0;
+  const double e = std::pow(std::min(code, 4095u) / 4095.0, 1.0 / m2);
+  return 10000.0 * std::pow(std::max(e - c1, 0.0) / (c2 - c3 * e), 1.0 / m1);
+}
+
+std::string Join(const std::vector<std::string>& values, const char* separator)
+{
+  return StringUtils::Join(values, separator);
+}
+
+// three significant digits, the precision of a 12-bit PQ code
+std::string Nits(double nits)
+{
+  if (nits >= 100)
+    return StringUtils::Format("{:.0f}", nits);
+  if (nits >= 10)
+    return StringUtils::Format("{:.1f}", nits);
+  if (nits >= 1)
+    return StringUtils::Format("{:.2f}", nits);
+  return StringUtils::Format("{:.4f}", nits);
+}
+
+const char* DrmChroma(uint32_t format)
+{
+  switch (format)
+  {
+    case DRM_FORMAT_NV12:
+    case DRM_FORMAT_NV21:
+    case DRM_FORMAT_NV15:
+    case DRM_FORMAT_P010:
+    case DRM_FORMAT_P030:
+    case DRM_FORMAT_YUV420:
+      return "4:2:0";
+    case DRM_FORMAT_NV16:
+    case DRM_FORMAT_NV20:
+    case DRM_FORMAT_P210:
+    case DRM_FORMAT_YUV422:
+      return "4:2:2";
+    case DRM_FORMAT_NV24:
+    case DRM_FORMAT_YUV444:
+      return "4:4:4";
+    default:
+      return nullptr;
+  }
+}
+
+std::string PixelFormat(const VideoPicture& picture, const AVFrame* frame)
+{
+  const char* chroma = nullptr;
+  if (frame && frame->format == AV_PIX_FMT_DRM_PRIME && frame->data[0])
+  {
+    const auto* descriptor = reinterpret_cast<const AVDRMFrameDescriptor*>(frame->data[0]);
+    if (descriptor->nb_layers > 0)
+      chroma = DrmChroma(descriptor->layers[0].format);
+  }
+  else
+  {
+    // a picture copied out of a software decoder: the decoder's format
+    const AVPixelFormat format =
+        frame ? static_cast<AVPixelFormat>(frame->format)
+              : av_get_pix_fmt(CServiceBroker::GetDataCacheCore().GetVideoPixelFormat().c_str());
+    const AVPixFmtDescriptor* desc = av_pix_fmt_desc_get(format);
+    if (desc && !(desc->flags & (AV_PIX_FMT_FLAG_HWACCEL | AV_PIX_FMT_FLAG_RGB)))
+      chroma = desc->log2_chroma_w == 0 ? "4:4:4" : desc->log2_chroma_h ? "4:2:0" : "4:2:2";
+  }
+
+  if (!chroma)
+    return StringUtils::Format("{}-bit", picture.colorBits);
+  return StringUtils::Format("YUV {} · {}-bit", chroma, picture.colorBits);
+}
+
+std::string ColourName(const VideoPicture& picture)
+{
+  std::vector<std::string> parts;
+  switch (picture.color_primaries)
+  {
+    case AVCOL_PRI_BT2020:
+      parts.emplace_back("BT.2020");
+      break;
+    case AVCOL_PRI_BT709:
+      parts.emplace_back("BT.709");
+      break;
+    case AVCOL_PRI_SMPTE432:
+      parts.emplace_back("P3-D65");
+      break;
+    case AVCOL_PRI_BT470BG:
+    case AVCOL_PRI_SMPTE170M:
+      parts.emplace_back("BT.601");
+      break;
+    default:
+      break;
+  }
+  switch (picture.color_transfer)
+  {
+    case AVCOL_TRC_SMPTE2084:
+      parts.emplace_back("PQ");
+      break;
+    case AVCOL_TRC_ARIB_STD_B67:
+      parts.emplace_back("HLG");
+      break;
+    case AVCOL_TRC_BT709:
+    case AVCOL_TRC_BT2020_10:
+    case AVCOL_TRC_BT2020_12:
+    case AVCOL_TRC_SMPTE170M:
+      parts.emplace_back("SDR gamma");
+      break;
+    default:
+      break;
+  }
+  if (parts.empty())
+    parts.emplace_back("Untagged");
+  parts.emplace_back(picture.color_range ? "Full" : "Limited");
+  return Join(parts, " · ");
+}
+
+void DescribeStatic(const VideoPicture& picture, DRMPRIME::PlayerInfo& info)
+{
+  if (picture.hasDisplayMetadata && picture.displayMetadata.has_luminance)
+    info["Info.Mastering"] =
+        StringUtils::Format("{} / {} nits", Nits(av_q2d(picture.displayMetadata.max_luminance)),
+                            Nits(av_q2d(picture.displayMetadata.min_luminance)));
+  if (picture.hasLightMetadata)
+    info["Info.LightLevel"] = StringUtils::Format("{} / {} nits", picture.lightMetadata.MaxCLL,
+                                                  picture.lightMetadata.MaxFALL);
+}
+
+void DescribeHDR10Plus(const AVFrame* frame, DRMPRIME::PlayerInfo& info)
+{
+  const AVFrameSideData* sd = av_frame_get_side_data(frame, AV_FRAME_DATA_DYNAMIC_HDR_PLUS);
+  if (!sd)
+    return;
+
+  const auto* hdr = reinterpret_cast<const AVDynamicHDRPlus*>(sd->data);
+  info["Info.HDR10Plus.Target"] =
+      Nits(av_q2d(hdr->targeted_system_display_maximum_luminance)) + " nits";
+  if (hdr->num_windows < 1)
+    return;
+
+  // MaxSCL and the average MaxRGB are fractions of 10000 nits
+  const AVHDRPlusColorTransformParams& params = hdr->params[0];
+  info["Info.HDR10Plus.MaxSCL"] =
+      StringUtils::Format("{:.0f} / {:.0f} / {:.0f} nits", 10000 * av_q2d(params.maxscl[0]),
+                          10000 * av_q2d(params.maxscl[1]), 10000 * av_q2d(params.maxscl[2]));
+  info["Info.HDR10Plus.Average"] = Nits(10000 * av_q2d(params.average_maxrgb)) + " nits";
+  if (params.tone_mapping_flag)
+    info["Info.HDR10Plus.Curve"] =
+        StringUtils::Format("knee {:.3f}, {:.3f} · {} anchors", av_q2d(params.knee_point_x),
+                            av_q2d(params.knee_point_y), params.num_bezier_curve_anchors);
+}
+
+const char* BaseLayerName(const VideoPicture& picture)
+{
+  if (picture.doviProfile == 5)
+    return "IPT-PQc2 BL";
+  if (picture.doviProfile == 8 && picture.doviCompatibility == 2)
+    return "SDR BL";
+  if (picture.doviProfile == 8 && picture.doviCompatibility == 4)
+    return "HLG BL";
+  return "HDR10 BL";
+}
+
+void DescribeLevels(const AVDOVIMetadata* metadata, DRMPRIME::PlayerInfo& info)
+{
+  std::vector<std::string> levels;
+  std::vector<std::string> l2;
+  std::vector<std::string> l8;
+  std::vector<std::string> l10;
+  for (int i = 0; i < metadata->num_ext_blocks; i++)
+  {
+    const AVDOVIDmData* block = av_dovi_get_ext(metadata, i);
+    const std::string level = StringUtils::Format("L{}", block->level);
+    if (std::ranges::find(levels, level) == levels.end())
+      levels.push_back(level);
+
+    switch (block->level)
+    {
+      case 1:
+        info["Info.DV.L1"] =
+            StringUtils::Format("{} / {} / {} nits", Nits(PQToNits(block->l1.min_pq)),
+                                Nits(PQToNits(block->l1.max_pq)), Nits(PQToNits(block->l1.avg_pq)));
+        break;
+      case 2:
+        l2.push_back(StringUtils::Format("{:.0f}", PQToNits(block->l2.target_max_pq)));
+        break;
+      case 3:
+        info["Info.DV.L3"] =
+            StringUtils::Format("{} / {} / {}", block->l3.min_pq_offset - 2048,
+                                block->l3.max_pq_offset - 2048, block->l3.avg_pq_offset - 2048);
+        break;
+      case 4:
+        info["Info.DV.L4"] =
+            StringUtils::Format("{} / {}", block->l4.anchor_pq, block->l4.anchor_power);
+        break;
+      case 5:
+        info["Info.DV.L5"] =
+            StringUtils::Format("{} / {} / {} / {}", block->l5.left_offset, block->l5.right_offset,
+                                block->l5.top_offset, block->l5.bottom_offset);
+        break;
+      case 6:
+        // the minimum is in 0.0001 nits
+        info["Info.DV.L6"] = StringUtils::Format("{} / {} nits", block->l6.max_luminance,
+                                                 Nits(block->l6.min_luminance / 10000.0));
+        info["Info.DV.L6Light"] =
+            StringUtils::Format("{} / {} nits", block->l6.max_cll, block->l6.max_fall);
+        break;
+      case 8:
+        l8.push_back(std::to_string(block->l8.target_display_index));
+        break;
+      case 9:
+        if (block->l9.source_primary_index == 0)
+          info["Info.DV.L9"] = "DCI-P3 D65";
+        else if (block->l9.source_primary_index == 2)
+          info["Info.DV.L9"] = "BT.2020";
+        else
+          info["Info.DV.L9"] = StringUtils::Format("index {}", block->l9.source_primary_index);
+        break;
+      case 10:
+        l10.push_back(StringUtils::Format("{}: {:.0f}", block->l10.target_display_index,
+                                          PQToNits(block->l10.target_max_pq)));
+        break;
+      case 11:
+      {
+        static constexpr const char* types[] = {"default", "film", "game", "sport",
+                                                "user-generated"};
+        const uint8_t type = block->l11.content_type;
+        info["Info.DV.L11"] = StringUtils::Format(
+            "{} · white point {}{}", type < std::size(types) ? types[type] : "other",
+            block->l11.whitepoint, block->l11.reference_mode_flag ? " · reference mode" : "");
+        break;
+      }
+      case 254:
+        info["Info.DV.L254"] =
+            StringUtils::Format("{} / {}", block->l254.dm_mode, block->l254.dm_version_index);
+        break;
+      case 255:
+        info["Info.DV.L255"] =
+            StringUtils::Format("{} / {}", block->l255.dm_run_mode, block->l255.dm_run_version);
+        break;
+      default:
+        break;
+    }
+  }
+
+  std::ranges::sort(levels, {},
+                    [](const std::string& level) { return std::stoi(level.substr(1)); });
+  info["Info.DV.Levels"] = Join(levels, " ");
+  if (!l2.empty())
+    info["Info.DV.L2"] = Join(l2, " · ") + " nits";
+  if (!l8.empty())
+    info["Info.DV.L8"] = Join(l8, " · ");
+  if (!l10.empty())
+    info["Info.DV.L10"] = Join(l10, " · ") + " nits";
+  info["Info.DV.CM"] = std::ranges::find(levels, "L254") != levels.end() ? "CM v4.0" : "CM v2.9";
+}
+} // namespace
+
+void DRMPRIME::DescribePicture(const VideoPicture& picture,
+                               const AVFrame* frame,
+                               const AVFrame* el,
+                               PlayerInfo& info)
+{
+  info["Info.Size"] = StringUtils::Format("{}x{}", picture.iWidth, picture.iHeight);
+  info["Info.PixelFormat"] = PixelFormat(picture, frame);
+  info["Info.Colour"] = ColourName(picture);
+  DescribeStatic(picture, info);
+  if (frame)
+    DescribeHDR10Plus(frame, info);
+
+  if (!picture.doviProfile)
+    return;
+
+  info["Info.DV.Profile"] = picture.doviProfile == 8
+                                ? StringUtils::Format("8.{}", picture.doviCompatibility)
+                                : std::to_string(picture.doviProfile);
+  info["Info.DV.Level"] = std::to_string(picture.doviLevel);
+  info["Info.DV.Layers"] = StringUtils::Format("{}{} + RPU", BaseLayerName(picture),
+                                               picture.doviProfile == 7 ? " + EL" : "");
+
+  const AVFrameSideData* sd =
+      frame ? av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_METADATA) : nullptr;
+  if (!sd && el)
+    sd = av_frame_get_side_data(el, AV_FRAME_DATA_DOVI_METADATA);
+  if (sd)
+    DescribeLevels(reinterpret_cast<const AVDOVIMetadata*>(sd->data), info);
+}
