+void CRendererDRMPRIME::UpdatePlayerInfo(CVideoBufferDRMPRIME* buffer)
+{
+  using namespace std::chrono_literals;
+  CDataCacheCore& dataCache = CServiceBroker::GetDataCacheCore();
+  const auto now = std::chrono::steady_clock::now();
+  if (!dataCache.IsPlayerInfoShown() || now - m_playerInfoTime < 500ms)
+    return;
+  m_playerInfoTime = now;
+
+  const auto* decoded = dynamic_cast<CVideoBufferDRMPRIMEFFmpeg*>(buffer);
+  DRMPRIME::PlayerInfo info;
+  DRMPRIME::DescribePicture(buffer->GetPicture(), decoded ? decoded->GetFrame() : nullptr,
+                            decoded ? decoded->GetEnhancementLayer() : nullptr, info);
+
+  auto* winSystem = static_cast<CWinSystemGbm*>(CServiceBroker::GetWinSystem());
+  const RESOLUTION_INFO& res = winSystem->GetGfxContext().GetResInfo();
+  info["Info.Display"] = StringUtils::Format("{}x{} / {:.3f} Hz", res.iScreenWidth,
+                                             res.iScreenHeight, res.fRefreshRate);
+  if (!m_hdrOutput)
+    info["Info.Signal"] = "SDR";
+  else if (buffer->GetPicture().color_transfer == AVCOL_TRC_ARIB_STD_B67)
+    info["Info.Signal"] = "HLG";
+  else
+    info["Info.Signal"] = "HDR10";
+#if defined(HAVE_PIDV)
+  if (m_dolbyVision)
+  {
+    info["Info.Signal"] = "Dolby Vision";
+    info["Info.Infoframe"] =
+        GetDolbyVisionInfoframe(m_videoSettings) == DolbyVisionOutput::DOLBY_VSIF ? "Dolby VSIF"
+                                                                                  : "HDMI VSIF";
+    m_dolbyVision->Describe(info, m_fps);
+  }
+#endif
+
+  dataCache.SetVideoPlayerInfo(std::move(info));
+}
