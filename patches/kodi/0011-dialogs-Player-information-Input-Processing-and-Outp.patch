+void CGUIDialogPlayerProcessInfo::UpdateProperties()
+{
+  m_updated = std::chrono::steady_clock::now();
+  CDataCacheCore& dataCache = CServiceBroker::GetDataCacheCore();
+
+  const auto info = dataCache.GetVideoPlayerInfo();
+  for (const std::string& name : m_properties)
+  {
+    if (!info.contains(name))
+      SetProperty(name, "");
+  }
+  m_properties.clear();
+  for (const auto& [name, value] : info)
+  {
+    SetProperty(name, value);
+    m_properties.insert(name);
+  }
+
+  const auto load = info.find("Info.RenderLoad");
+  CGUIMessage render(GUI_MSG_ITEM_SELECT, GetID(), CONTROL_RENDER_METER,
+                     load != info.end() ? std::min(std::stoi(load->second), 100) : 0);
+  OnMessage(render);
+
+  // System.Memory reads /proc/meminfo at every frame it is shown
+  KODI::MEMORY::MemoryStatus memory;
+  KODI::MEMORY::GetMemoryStatus(&memory);
+  const int used =
+      memory.totalPhys ? static_cast<int>(100 - memory.availPhys * 100 / memory.totalPhys) : 0;
+  SetProperty("Info.Memory", StringUtils::Format("{} %", used));
+  CGUIMessage meter(GUI_MSG_ITEM_SELECT, GetID(), CONTROL_MEMORY_METER, used);
+  OnMessage(meter);
+
+  if (CServiceBroker::GetCPUInfo()->SupportsCPUUsage())
+    SetProperty("Info.CPU",
+                StringUtils::Format("{} %", CServiceBroker::GetCPUInfo()->GetUsedPercentage()));
+
+  SetProperty("Info.DroppedSkipped", StringUtils::Format("{} / {}", dataCache.GetVideoDropped(),
+                                                         dataCache.GetVideoSkipped()));
+}
