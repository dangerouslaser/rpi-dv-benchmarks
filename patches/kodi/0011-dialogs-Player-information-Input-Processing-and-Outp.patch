+void CDVTunnelDRMPRIME::Describe(DRMPRIME::PlayerInfo& info, float fps) const
+{
+  info["Info.Engine"] = DeviceName();
+  switch (m_layers)
+  {
+    case Layers::FULL:
+      info["Info.DV.Layers"] = "HDR10 BL + FEL + RPU";
+      info["Info.Reconstruction"] =
+          StringUtils::Format("BL + FEL · {} upscale", UpscaleName(m_options.elUpscale));
+      break;
+    case Layers::MINIMAL:
+      info["Info.DV.Layers"] = "HDR10 BL + MEL + RPU";
+      info["Info.Reconstruction"] = "BL (MEL: no residual)";
+      break;
+    case Layers::OFF:
+      info["Info.Reconstruction"] = "BL (enhancement layer off)";
+      break;
+    default:
+      info["Info.Reconstruction"] = "BL";
+      break;
+  }
+  info["Info.ChromaMapping"] =
+      m_mmr ? StringUtils::Format("MMR · {}", MMRName(m_options.mmr)) : "Polynomial";
+  info["Info.Filters"] = m_options.filters == PI_FILTERS_PHASE ? "Phase" : "CB1";
+  info["Info.Link"] = "RGB 8-bit tunnel";
+
+  if (m_gpuMs > 0 && fps > 0)
+  {
+    const double frameMs = 1000.0 / static_cast<double>(fps);
+    info["Info.GPU"] = StringUtils::Format("{:.1f} of {:.1f} ms", m_gpuMs, frameMs);
+    info["Info.RenderLoad"] =
+        std::to_string(static_cast<int>(std::lround(100.0 * m_gpuMs / frameMs)));
+  }
+}
