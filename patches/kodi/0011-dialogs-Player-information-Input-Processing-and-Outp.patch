+
+bool UsesMMR(const AVFrame* frame)
+{
+  const AVFrameSideData* sd = av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_METADATA);
+  if (!sd)
+    return false;
+  const AVDOVIDataMapping* mapping =
+      av_dovi_get_mapping(reinterpret_cast<const AVDOVIMetadata*>(sd->data));
+  for (int c = 1; c < 3; c++)
+  {
+    for (int piece = 0; piece < mapping->curves[c].num_pivots - 1; piece++)
+    {
+      if (mapping->curves[c].mapping_idc[piece] == AV_DOVI_MAPPING_MMR)
+        return true;
+    }
+  }
+  return false;
+}
