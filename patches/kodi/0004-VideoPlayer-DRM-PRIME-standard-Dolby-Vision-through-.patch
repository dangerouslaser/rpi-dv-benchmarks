+#include "DVTunnelDRMPRIME.h"
+
+#include "cores/VideoPlayer/Buffers/VideoBufferDRMPRIME.h"
+#include "filesystem/SpecialProtocol.h"
+#include "threads/CriticalSection.h"
+#include "utils/StringUtils.h"
+#include "utils/log.h"
+
+#include <deque>
+#include <mutex>
+#include <vector>
+
+#include <drm_fourcc.h>
+#include <fcntl.h>
+#include <linux/dma-heap.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+namespace
+{
+// one on the plane, one leaving it, one being rendered, one spare
+constexpr int OUTPUTS = 4;
+
+void Log(void* /*opaque*/, pi_log_level level, const char* message)
+{
+  int kodiLevel = LOGDEBUG;
+  if (level == PI_LOG_ERROR)
+    kodiLevel = LOGERROR;
+  else if (level == PI_LOG_WARNING)
+    kodiLevel = LOGWARNING;
+  else if (level == PI_LOG_INFO)
+    kodiLevel = LOGINFO;
+
+  std::string text(message);
+  StringUtils::TrimRight(text);
+  CLog::Log(kodiLevel, "CDVTunnelDRMPRIME: {}", text);
+}
+
+// the system heap: CMA is the decoder's, and the display scans out of either
+int AllocateDmaBuf(uint64_t size)
+{
+  int heap = open("/dev/dma_heap/system", O_RDWR | O_CLOEXEC);
+  if (heap < 0)
+    return -1;
+
+  dma_heap_allocation_data data{};
+  data.len = size;
+  data.fd_flags = O_RDWR | O_CLOEXEC;
+  int ret = ioctl(heap, DMA_HEAP_IOCTL_ALLOC, &data);
+  close(heap);
+
+  return ret < 0 ? -1 : static_cast<int>(data.fd);
+}
+} // namespace
+
+//! \brief A tunnel frame: an XRGB8888 linear dma-buf the engine renders into
+class CDVTunnelOutput : public CVideoBufferDRMPRIME
+{
+public:
+  CDVTunnelOutput(int id, int fd, uint32_t width, uint32_t height, uint32_t stride, uint64_t size)
+    : CVideoBufferDRMPRIME(id), m_fd(fd), m_size(size), m_stride(stride)
+  {
+    m_descriptor.nb_objects = 1;
+    m_descriptor.objects[0].fd = fd;
+    m_descriptor.objects[0].size = size;
+    m_descriptor.objects[0].format_modifier = DRM_FORMAT_MOD_LINEAR;
+    m_descriptor.nb_layers = 1;
+    m_descriptor.layers[0].format = DRM_FORMAT_XRGB8888;
+    m_descriptor.layers[0].nb_planes = 1;
+    m_descriptor.layers[0].planes[0].object_index = 0;
+    m_descriptor.layers[0].planes[0].offset = 0;
+    m_descriptor.layers[0].planes[0].pitch = stride;
+
+    VideoPicture picture;
+    picture.Reset();
+    picture.iWidth = picture.iDisplayWidth = width;
+    picture.iHeight = picture.iDisplayHeight = height;
+    picture.color_range = 1;
+    picture.colorBits = 8;
+    SetPictureParams(picture);
+  }
+
+  ~CDVTunnelOutput() override { close(m_fd); }
+
+  AVDRMFrameDescriptor* GetDescriptor() const override { return &m_descriptor; }
+
+  int m_fd;
+  uint64_t m_size;
+  uint32_t m_stride;
+  pi_output* m_output = nullptr;
+
+private:
+  mutable AVDRMFrameDescriptor m_descriptor{};
+};
+
+//! \brief The tunnel's outputs. An output on the video plane holds the pool, so it outlives the engine.
+class CDVTunnelOutputPool : public IVideoBufferPool
+{
+public:
+  CVideoBuffer* Get() override
+  {
+    std::unique_lock lock(m_critSection);
+    if (m_free.empty())
+      return nullptr;
+
+    CDVTunnelOutput* output = m_outputs[m_free.front()].get();
+    m_free.pop_front();
+    output->Acquire(GetPtr());
+    return output;
+  }
+
+  void Return(int id) override
+  {
+    std::unique_lock lock(m_critSection);
+    m_free.push_back(id);
+  }
+
+  void Add(std::unique_ptr<CDVTunnelOutput> output)
+  {
+    std::unique_lock lock(m_critSection);
+    m_free.push_back(static_cast<int>(m_outputs.size()));
+    m_outputs.emplace_back(std::move(output));
+  }
+
+  void ReleaseImports(pi_engine* engine)
+  {
+    std::unique_lock lock(m_critSection);
+    for (auto& output : m_outputs)
+    {
+      if (output->m_output)
+        pi_output_release(engine, output->m_output);
+      output->m_output = nullptr;
+    }
+  }
+
+private:
+  CCriticalSection m_critSection;
+  std::vector<std::unique_ptr<CDVTunnelOutput>> m_outputs;
+  std::deque<int> m_free;
+};
+
+bool CDVTunnelDRMPRIME::Supports(const VideoPicture& picture)
+{
+  if (picture.hdrType != StreamHdrType::HDR_TYPE_DOLBYVISION ||
+      (picture.doviProfile != 5 && picture.doviProfile != 7 && picture.doviProfile != 8))
+    return false;
+
+  static const bool available = []
+  {
+    pi_probe_info info{};
+    if (pi_api_version() != PI_API_VERSION || pi_probe(nullptr, &info) != PI_OK)
+    {
+      CLog::Log(LOGINFO, "CDVTunnelDRMPRIME: no Vulkan device for the Dolby Vision engine");
+      return false;
+    }
+    // a CPU implementation isn't real time, and KMS needs the render's fence
+    if (info.cpu || !info.release_fence)
+    {
+      CLog::Log(LOGINFO, "CDVTunnelDRMPRIME: {} can't drive the Dolby Vision engine",
+                info.device);
+      return false;
+    }
+    return true;
+  }();
+
+  return available;
+}
+
+std::unique_ptr<CDVTunnelDRMPRIME> CDVTunnelDRMPRIME::Create(const VideoPicture& picture,
+                                                             const Options& options)
+{
+  std::unique_ptr<CDVTunnelDRMPRIME> tunnel(new CDVTunnelDRMPRIME());
+  tunnel->m_options = options;
+  tunnel->m_pipelineCache = CSpecialProtocol::TranslatePath("special://temp/pi_engine.cache");
+
+  pi_options o;
+  pi_options_default(&o);
+  o.mmr = options.mmr;
+  o.filters = options.filters;
+  o.el_upscale = options.elUpscale;
+  o.pipeline_cache = tunnel->m_pipelineCache.c_str();
+  o.log = Log;
+  o.log_level = PI_LOG_INFO;
+
+  int ret = pi_engine_create(&o, &tunnel->m_engine);
+  if (ret != PI_OK)
+  {
+    CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: engine: {}", pi_strerror(ret));
+    return nullptr;
+  }
+
+  tunnel->m_info.width = picture.iWidth;
+  tunnel->m_info.height = picture.iHeight;
+  tunnel->m_info.profile = picture.doviProfile;
+  ret = pi_stream_open(tunnel->m_engine, &tunnel->m_info);
+  if (ret != PI_OK)
+  {
+    CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: stream {}x{}: {}", picture.iWidth, picture.iHeight,
+              pi_strerror(ret));
+    return nullptr;
+  }
+
+  uint32_t stride;
+  uint64_t bytes;
+  ret = pi_output_size(picture.iWidth, picture.iHeight, &stride, &bytes);
+  if (ret != PI_OK)
+    return nullptr;
+  bytes = (bytes + 4095) & ~static_cast<uint64_t>(4095);
+
+  tunnel->m_pool = std::make_shared<CDVTunnelOutputPool>();
+  for (int i = 0; i < OUTPUTS; i++)
+  {
+    int fd = AllocateDmaBuf(bytes);
+    if (fd < 0)
+    {
+      CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: no {} byte buffer from the system DMA heap", bytes);
+      return nullptr;
+    }
+
+    auto output = std::make_unique<CDVTunnelOutput>(i, fd, picture.iWidth, picture.iHeight,
+                                                    stride, bytes);
+    ret = pi_output_import(tunnel->m_engine, fd, picture.iWidth, picture.iHeight, stride, bytes,
+                           &output->m_output);
+    if (ret != PI_OK)
+    {
+      CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: output import: {}", pi_strerror(ret));
+      return nullptr;
+    }
+    tunnel->m_pool->Add(std::move(output));
+  }
+
+  CLog::Log(LOGINFO, "CDVTunnelDRMPRIME: profile {} at {}x{}: {}", picture.doviProfile,
+            picture.iWidth, picture.iHeight, pi_engine_describe(tunnel->m_engine));
+
+  return tunnel;
+}
+
+CDVTunnelDRMPRIME::~CDVTunnelDRMPRIME()
+{
+  if (!m_engine)
+    return;
+
+  pi_stream_close(m_engine);
+  if (m_pool)
+    m_pool->ReleaseImports(m_engine);
+  pi_engine_destroy(m_engine);
+}
+
+bool CDVTunnelDRMPRIME::SetOptions(const Options& options)
+{
+  if (options == m_options)
+    return true;
+
+  pi_options o;
+  pi_options_default(&o);
+  o.mmr = options.mmr;
+  o.filters = options.filters;
+  o.el_upscale = options.elUpscale;
+
+  int ret = pi_engine_configure(m_engine, &o);
+  if (ret == PI_OK)
+    ret = pi_stream_open(m_engine, &m_info);
+
+  if (ret != PI_OK)
+  {
+    CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: options: {}", pi_strerror(ret));
+    return false;
+  }
+
+  m_options = options;
+  m_failures = 0;
+  CLog::Log(LOGINFO, "CDVTunnelDRMPRIME: {}, enhancement layer {}", pi_engine_describe(m_engine),
+            m_options.enhancementLayer ? "where needed" : "off");
+  return true;
+}
+
+void CDVTunnelDRMPRIME::Flush()
+{
+  int ret = pi_stream_open(m_engine, &m_info);
+  if (ret != PI_OK)
+    CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: stream: {}", pi_strerror(ret));
+}
+
+CVideoBufferDRMPRIME* CDVTunnelDRMPRIME::Render(CVideoBufferDRMPRIME* buffer, int& fence)
+{
+  fence = -1;
+
+  auto* decoded = dynamic_cast<CVideoBufferDRMPRIMEFFmpeg*>(buffer);
+  if (!decoded)
+    return nullptr;
+
+  auto* output = static_cast<CDVTunnelOutput*>(m_pool->Get());
+  if (!output)
+  {
+    CLog::Log(LOGWARNING, "CDVTunnelDRMPRIME: no free output");
+    return nullptr;
+  }
+
+  pi_frame frame{};
+  frame.bl = decoded->GetFrame();
+  frame.chroma_top_left = pi_chroma_top_left(frame.bl, m_info.profile);
+  frame.pts_us = static_cast<int64_t>(buffer->GetPicture().pts);
+  frame.acquire_fd = -1;
+
+  int ret = pi_render(m_engine, &frame, output->m_output, &fence);
+  if (ret != PI_OK)
+  {
+    if (m_failures++ == 0)
+      CLog::Log(LOGERROR, "CDVTunnelDRMPRIME: render: {}", pi_strerror(ret));
+    output->Release();
+    return nullptr;
+  }
+
+  return output;
+}
