+
+#pragma once
+
+#include <memory>
+#include <string>
+
+extern "C"
+{
+#include <pi_engine.h>
+}
+
+class CVideoBufferDRMPRIME;
+class CDVTunnelOutputPool;
+struct VideoPicture;
+
+/*!
+ * \brief Standard (TV-led) Dolby Vision for the DRM PRIME video plane: renders
+ * each decoded picture, with its RPU and enhancement layer, into the 8-bit RGB
+ * tunnel frame the sink decodes, with libpi_engine on the GPU.
+ */
+class CDVTunnelDRMPRIME
+{
+public:
+  struct Options
+  {
+    pi_mmr_mode mmr = PI_MMR_EXACT;
+    pi_filters filters = PI_FILTERS_CB1;
+    pi_el_upscale elUpscale = PI_EL_BILINEAR;
+    //! render the enhancement layer where the RPU needs it (FEL); false: the base layer alone
+    bool enhancementLayer = true;
+
+    bool operator==(const Options& other) const = default;
+  };
+
+  ~CDVTunnelDRMPRIME();
+
+  //! \brief Whether the picture is Dolby Vision the engine renders, on a usable GPU
+  static bool Supports(const VideoPicture& picture);
+
+  static std::unique_ptr<CDVTunnelDRMPRIME> Create(const VideoPicture& picture,
+                                                   const Options& options);
+
+  //! \brief Applies changed options, reopening the engine's stream
+  bool SetOptions(const Options& options);
+  /*!
+   * \brief Reopens the engine's stream: it releases its imports of the decoder's buffers,
+   * which would keep buffers the decoder has let go of allocated
+   */
+  void Flush();
+  const Options& GetOptions() const { return m_options; }
+
+  unsigned int GetWidth() const { return m_info.width; }
+  unsigned int GetHeight() const { return m_info.height; }
+
+  /*!
+   * \brief Renders the picture into a free output.
+   * \param fence Set to a sync_file signalled when the output is complete, or -1
+   * \return The output, acquired (the caller releases it), or nullptr
+   */
+  CVideoBufferDRMPRIME* Render(CVideoBufferDRMPRIME* buffer, int& fence);
+
+private:
+  CDVTunnelDRMPRIME() = default;
+
+  pi_engine* m_engine = nullptr;
+  pi_stream_info m_info{};
+  Options m_options;
+  std::string m_pipelineCache;
+  std::shared_ptr<CDVTunnelOutputPool> m_pool;
+  unsigned int m_failures = 0;
+};
