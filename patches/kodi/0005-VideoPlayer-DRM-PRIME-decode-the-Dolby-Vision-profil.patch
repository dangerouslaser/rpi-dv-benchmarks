+namespace
+{
+// Base layer pictures (4K: 16 MB of CMA each) held waiting for their enhancement layer.
+// After a seek its decoder may give nothing for a while: base layer pictures whose
+// enhancement layer never comes are then let go as the pairer decides.
+constexpr int HELD_WITHOUT_EL = 6;
+constexpr int HELD = 12;
+
+enum AVPixelFormat GetFormat(struct AVCodecContext* /*avctx*/, const enum AVPixelFormat* fmt)
+{
+  for (int n = 0; fmt[n] != AV_PIX_FMT_NONE; n++)
+  {
+    if (fmt[n] == AV_PIX_FMT_DRM_PRIME)
+      return fmt[n];
+  }
+
+  CLog::Log(LOGERROR, "CDVELDecoderDRMPRIME: no DRM PRIME decoder for the enhancement layer");
+  return AV_PIX_FMT_NONE;
+}
+} // namespace
+
+std::unique_ptr<CDVELDecoderDRMPRIME> CDVELDecoderDRMPRIME::Create(const CDVDStreamInfo& hints,
+                                                                   AVCodecContext* base)
+{
+  if (hints.hdrType != StreamHdrType::HDR_TYPE_DOLBYVISION || hints.dovi.dv_profile != 7 ||
+      !hints.dovi.el_present_flag || !base->hw_device_ctx)
+    return nullptr;
+
+  // single-track: the enhancement layer's NAL units are in the base layer's, as type 63
+  const uint8_t* extradata = static_cast<const uint8_t*>(hints.extradata.GetData());
+  if (hints.extradata.GetSize() < 23 || extradata[0] != 1)
+    return nullptr;
+
+  const auto allowedHdrFormats = std::dynamic_pointer_cast<CSettingList>(
+      CServiceBroker::GetSettingsComponent()->GetSettings()->GetSetting(
+          CSettings::SETTING_VIDEOPLAYER_ALLOWEDHDRFORMATS));
+  if (!CSettingUtils::FindIntInList(allowedHdrFormats,
+                                    CSettings::VIDEOPLAYER_ALLOWED_HDR_TYPE_DOLBY_VISION) ||
+      !CServiceBroker::GetWinSystem()->GetDisplayHDRCapabilities().SupportsDolbyVision())
+    return nullptr;
+
+  std::unique_ptr<CDVELDecoderDRMPRIME> el(new CDVELDecoderDRMPRIME());
+  el->m_nalSize = (extradata[21] & 3) + 1;
+  el->m_decoder[0] = base;
+
+  const AVCodec* codec = avcodec_find_decoder(AV_CODEC_ID_HEVC);
+  AVCodecContext* decoder = codec ? avcodec_alloc_context3(codec) : nullptr;
+  el->m_decoder[1] = decoder;
+  if (!decoder)
+    return nullptr;
+
+  decoder->hw_device_ctx = av_buffer_ref(base->hw_device_ctx);
+  decoder->get_format = GetFormat;
+  decoder->time_base = base->time_base;
+  decoder->pkt_timebase = base->pkt_timebase;
+  av_opt_set(decoder->priv_data, "dmabuf_alloc", "cma", 0);
+
+  if (!decoder->hw_device_ctx || avcodec_open2(decoder, codec, nullptr) < 0 ||
+      pi_pairer_create(2, &el->m_pairer) != PI_OK)
+  {
+    CLog::Log(LOGERROR, "CDVELDecoderDRMPRIME: unable to open the enhancement layer's decoder");
+    return nullptr;
+  }
+
+  el->m_queueSize = pi_pairer_room(el->m_pairer, 0);
+  el->m_enhancementLayer = av_frame_alloc();
+  if (!el->m_enhancementLayer)
+    return nullptr;
+
+  CLog::Log(LOGINFO, "CDVELDecoderDRMPRIME: decoding the profile 7 enhancement layer");
+  return el;
+}
+
+CDVELDecoderDRMPRIME::~CDVELDecoderDRMPRIME()
+{
+  pi_pairer_destroy(m_pairer);
+  for (AVPacket*& packet : m_pending)
+    av_packet_free(&packet);
+  av_frame_free(&m_enhancementLayer);
+  avcodec_free_context(&m_decoder[1]);
+}
+
+AVPacket* CDVELDecoderDRMPRIME::LayerPacket(int layer, const AVPacket* packet) const
+{
+  const int room = packet->size + 256;
+  AVPacket* out = av_packet_alloc();
+  if (!out || av_new_packet(out, room) < 0)
+  {
+    av_packet_free(&out);
+    return nullptr;
+  }
+
+  const int size = pi_p7_split(packet->data, packet->size, m_nalSize, layer, out->data, room);
+  if (size <= 0 || av_packet_copy_props(out, packet) < 0)
+  {
+    av_packet_free(&out);
+    return nullptr;
+  }
+  out->size = size;
+  return out;
+}
+
+int CDVELDecoderDRMPRIME::Held(int layer) const
+{
+  return m_queueSize - pi_pairer_room(m_pairer, layer);
+}
+
+int CDVELDecoderDRMPRIME::Receive(int layer)
+{
+  AVCodecContext* decoder = m_decoder[layer];
+  int received = 0;
+
+  while (decoder && pi_pairer_room(m_pairer, layer) > 0 && (layer || Held(0) < HELD))
+  {
+    AVFrame* frame = av_frame_alloc();
+    if (!frame)
+      return AVERROR(ENOMEM);
+
+    int ret = avcodec_receive_frame(decoder, frame);
+    if (ret < 0)
+    {
+      av_frame_free(&frame);
+      if (ret == AVERROR_EOF)
+        m_eof[layer] = true;
+      return ret == AVERROR(EAGAIN) || ret == AVERROR_EOF ? received : ret;
+    }
+
+    if (pi_pairer_push(m_pairer, layer, frame, layer ? decoder->has_b_frames : 0) != 0)
+    {
+      av_frame_free(&frame);
+      return AVERROR(EINVAL);
+    }
+    received++;
+  }
+
+  return received;
+}
+
+int CDVELDecoderDRMPRIME::Send(int layer, const AVPacket* packet)
+{
+  if (!m_decoder[layer])
+    return 0;
+
+  for (;;)
+  {
+    int ret = avcodec_send_packet(m_decoder[layer], packet);
+    if (ret == AVERROR(EAGAIN))
+    {
+      ret = Receive(layer);
+      if (ret < 0)
+        return ret;
+      if (ret == 0)
+        return AVERROR(EAGAIN);
+      continue;
+    }
+
+    if (ret < 0 && ret != AVERROR_EOF)
+      return ret;
+
+    ret = Receive(layer);
+    return ret < 0 ? ret : 0;
+  }
+}
+
+int CDVELDecoderDRMPRIME::SendPacket(const AVPacket* packet)
+{
+  // a layer's packet its decoder couldn't take goes first
+  for (int layer = 0; layer < 2; layer++)
+  {
+    if (!m_pending[layer])
+      continue;
+
+    int ret = Send(layer, m_pending[layer]);
+    if (ret == AVERROR(EAGAIN))
+      return ret;
+    av_packet_free(&m_pending[layer]);
+    if (ret < 0)
+      return ret;
+  }
+
+  for (int layer = 0; layer < 2; layer++)
+  {
+    if (!m_decoder[layer])
+      continue;
+
+    AVPacket* layerPacket = LayerPacket(layer, packet);
+    if (!layerPacket)
+      continue;
+
+    int ret = Send(layer, layerPacket);
+    if (ret == AVERROR(EAGAIN))
+    {
+      m_pending[layer] = layerPacket;
+      continue;
+    }
+
+    av_packet_free(&layerPacket);
+    if (ret < 0)
+      return ret;
+  }
+
+  return 0;
+}
+
+void CDVELDecoderDRMPRIME::LogPairing()
+{
+  pi_pair_stats stats;
+  pi_pairer_stats(m_pairer, &stats);
+
+  if (stats.el_absent && m_decoder[1])
+  {
+    CLog::Log(LOGINFO, "CDVELDecoderDRMPRIME: no enhancement layer pictures: base layer only");
+    avcodec_free_context(&m_decoder[1]);
+    av_packet_free(&m_pending[1]);
+  }
+
+  if (stats.bl_dropped != m_logged[0] || stats.el_dropped != m_logged[1] ||
+      stats.bl_alone != m_logged[2])
+  {
+    CLog::Log(LOGDEBUG,
+              "CDVELDecoderDRMPRIME: unpaired pictures: {} base layer dropped, {} enhancement "
+              "layer dropped, {} base layer alone",
+              stats.bl_dropped, stats.el_dropped, stats.bl_alone);
+    m_logged[0] = stats.bl_dropped;
+    m_logged[1] = stats.el_dropped;
+    m_logged[2] = stats.bl_alone;
+  }
+}
+
+int CDVELDecoderDRMPRIME::ReceiveFrame(AVFrame* frame)
+{
+  av_frame_unref(m_enhancementLayer);
+
+  for (;;)
+  {
+    const bool end = m_eof[0] && (m_eof[1] || !m_decoder[1]);
+    const bool full =
+        m_decoder[1] && (Held(0) >= HELD || (Held(0) >= HELD_WITHOUT_EL && Held(1) == 0));
+    AVFrame* bl = nullptr;
+    AVFrame* el = nullptr;
+    int ret = pi_pairer_pop(m_pairer, end || full, &bl, &el);
+    LogPairing();
+    if (ret < 0)
+      return AVERROR(EINVAL);
+
+    if (ret == 1)
+    {
+      av_frame_move_ref(frame, bl);
+      av_frame_free(&bl);
+      if (el)
+        av_frame_move_ref(m_enhancementLayer, el);
+      av_frame_free(&el);
+      return 0;
+    }
+
+    if (end)
+      return AVERROR_EOF;
+
+    int received = 0;
+    for (int layer = 0; layer < 2; layer++)
+    {
+      ret = Receive(layer);
+      if (ret < 0)
+        return ret;
+      received += ret;
+    }
+
+    if (!received && !(m_eof[0] && (m_eof[1] || !m_decoder[1])))
+      return AVERROR(EAGAIN);
+  }
+}
+
+void CDVELDecoderDRMPRIME::Attach(CVideoBufferDRMPRIMEFFmpeg* buffer)
+{
+  if (m_enhancementLayer->buf[0])
+    buffer->SetEnhancementLayerRef(m_enhancementLayer);
+}
+
+void CDVELDecoderDRMPRIME::Drain()
+{
+  if (m_pending[1])
+    return;
+
+  int ret = Send(1, nullptr);
+  if (ret < 0 && ret != AVERROR(EAGAIN))
+    CLog::Log(LOGERROR, "CDVELDecoderDRMPRIME: enhancement layer drain failed ({})", ret);
+}
+
+void CDVELDecoderDRMPRIME::Flush()
+{
+  for (AVPacket*& packet : m_pending)
+    av_packet_free(&packet);
+  if (m_decoder[1])
+    avcodec_flush_buffers(m_decoder[1]);
+  pi_pairer_flush(m_pairer);
+  av_frame_unref(m_enhancementLayer);
+  m_eof[0] = m_eof[1] = false;
+}
