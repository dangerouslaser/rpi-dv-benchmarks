+#include "ServiceBroker.h"
+#include "cores/VideoPlayer/Buffers/VideoBufferDRMPRIME.h"
+#include "cores/VideoPlayer/DVDStreamInfo.h"
+#include "settings/SettingUtils.h"
+#include "settings/Settings.h"
