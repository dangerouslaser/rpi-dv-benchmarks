+  int ReceiveFrame(AVFrame* frame);
+  //! \brief Gives the last received picture's enhancement layer to the buffer
+  void Attach(CVideoBufferDRMPRIMEFFmpeg* buffer);
+  //! \brief Drains the enhancement layer's decoder (the base layer's is the caller's)
+  void Drain();
+  //! \brief After the base layer's decoder is flushed: drops everything held
+  void Flush();
+
