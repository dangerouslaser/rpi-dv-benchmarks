+{
+  VS_DOLBYVISION_UPSCALE_BILINEAR = 0,
+  VS_DOLBYVISION_UPSCALE_ANNEX_B = 1, //!< ETSI GS CCM 001 Annex B's filters
+  VS_DOLBYVISION_UPSCALE_BICUBIC = 2, //!< Catmull-Rom
