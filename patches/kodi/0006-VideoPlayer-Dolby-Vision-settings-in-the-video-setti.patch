+  VS_DOLBYVISION_MMR_FLOAT = 3,
+};
+
+enum EDOLBYVISIONFILTERS
+{
+  VS_DOLBYVISION_FILTERS_CB1 = 0,
+  VS_DOLBYVISION_FILTERS_PHASE = 1,
+};
+
+enum EDOLBYVISIONINFOFRAME
+{
+  VS_DOLBYVISION_INFOFRAME_AUTO = 0, //!< as the sink's EDID suggests
+  VS_DOLBYVISION_INFOFRAME_HDMI = 1,
+  VS_DOLBYVISION_INFOFRAME_DOLBY = 2,
+};
