+CDVTunnelDRMPRIME::Options GetDolbyVisionOptions(const CVideoSettings& settings)
+{
+  CDVTunnelDRMPRIME::Options options;
+  switch (settings.m_DolbyVisionMMR)
+  {
+    case VS_DOLBYVISION_MMR_SPLIT:
+      options.mmr = PI_MMR_SPLIT;
+      break;
+    case VS_DOLBYVISION_MMR_EXACT64:
+      options.mmr = PI_MMR_EXACT64;
+      break;
+    case VS_DOLBYVISION_MMR_FLOAT:
+      options.mmr = PI_MMR_FLOAT;
+      break;
+    default:
+      options.mmr = PI_MMR_EXACT;
+      break;
+  }
+  options.filters = settings.m_DolbyVisionFilters == VS_DOLBYVISION_FILTERS_PHASE
+                        ? PI_FILTERS_PHASE
+                        : PI_FILTERS_CB1;
+  switch (settings.m_DolbyVisionUpscale)
+  {
+    case VS_DOLBYVISION_UPSCALE_ANNEX_B:
+      options.elUpscale = PI_EL_ANNEX_B;
+      break;
+    case VS_DOLBYVISION_UPSCALE_BICUBIC:
+      options.elUpscale = PI_EL_BICUBIC;
+      break;
+    case VS_DOLBYVISION_UPSCALE_LANCZOS:
+      options.elUpscale = PI_EL_LANCZOS;
+      break;
+    default:
+      options.elUpscale = PI_EL_BILINEAR;
+      break;
+  }
+  options.enhancementLayer = settings.m_DolbyVisionEL != VS_DOLBYVISION_EL_OFF;
+  return options;
+}
+
+DolbyVisionOutput GetDolbyVisionInfoframe(const CVideoSettings& settings)
+{
+  if (settings.m_DolbyVisionInfoframe == VS_DOLBYVISION_INFOFRAME_HDMI)
+    return DolbyVisionOutput::HDMI_VSIF;
+  if (settings.m_DolbyVisionInfoframe == VS_DOLBYVISION_INFOFRAME_DOLBY)
+    return DolbyVisionOutput::DOLBY_VSIF;
+  return static_cast<CWinSystemGbm*>(CServiceBroker::GetWinSystem())
+      ->GetDolbyVisionDefaultOutput();
+}
