+void CRendererDRMPRIME::UpdateDolbyVisionOutput(const VideoPicture& picture)
+{
+#if defined(HAVE_PIDV)
+  if (!m_dolbyVisionCapable)
+    return;
+
+  if (m_videoSettings.m_DolbyVision != m_dolbyVisionEnabled)
+  {
+    CLog::Log(LOGINFO, "CRendererDRMPRIME: Dolby Vision output {}",
+              m_videoSettings.m_DolbyVision ? "on" : "off");
+    if (m_dolbyVisionEnabled)
+    {
+      m_dolbyVisionEnabled = false;
+      ResetDolbyVisionOutput(picture);
+    }
+    else if (!SetDolbyVisionOutput(picture))
+      SetHDROutput(picture);
+  }
+
+  if (!m_dolbyVision)
+    return;
+
+  m_dolbyVision->SetOptions(GetDolbyVisionOptions(m_videoSettings));
+  static_cast<CWinSystemGbm*>(CServiceBroker::GetWinSystem())
+      ->SetDolbyVision(GetDolbyVisionInfoframe(m_videoSettings));
+#endif
+}
+
 bool CRendererDRMPRIME::RenderDolbyVision(CVideoBufferDRMPRIME* buffer)
 {
 #if defined(HAVE_PIDV)
+  UpdateDolbyVisionOutput(buffer->GetPicture());
   if (!m_dolbyVision)
