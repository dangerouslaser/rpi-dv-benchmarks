diff --git a/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c b/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c
index 70f9aa702..f5329288f 100644
--- a/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c
+++ b/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c
@@ -2142,6 +2142,557 @@ static void drm_test_check_disable_connector(struct kunit *test)
 	drm_modeset_acquire_fini(&ctx);
 }
 
+/*
+ * The connector's state in @state, enabled on its CRTC with @mode, with
+ * Broadcast RGB set to Full and the Dolby Vision property to @dolby_vision.
+ */
+static struct drm_connector_state *
+dolby_vision_conn_state(struct kunit *test,
+			struct drm_atomic_helper_connector_hdmi_priv *priv,
+			struct drm_atomic_state *state,
+			const struct drm_display_mode *mode,
+			enum drm_hdmi_dolby_vision dolby_vision)
+{
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	int ret;
+
+	conn_state = drm_atomic_get_connector_state(state, &priv->connector);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, conn_state);
+
+	ret = drm_atomic_set_crtc_for_connector(conn_state, priv->crtc);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	crtc_state = drm_atomic_get_crtc_state(state, priv->crtc);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, crtc_state);
+
+	ret = drm_atomic_set_mode_for_crtc(crtc_state, mode);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	crtc_state->enable = true;
+	crtc_state->active = true;
+
+	conn_state->hdmi.broadcast_rgb = DRM_HDMI_BROADCAST_RGB_FULL;
+	conn_state->hdmi.dolby_vision = dolby_vision;
+
+	return conn_state;
+}
+
+static const enum drm_hdmi_dolby_vision check_dolby_vision_tests[] = {
+	DRM_HDMI_DOLBY_VISION_STANDARD_HDMI_VSIF,
+	DRM_HDMI_DOLBY_VISION_STANDARD_DOLBY_VSIF,
+};
+
+static void
+check_dolby_vision_desc(const enum drm_hdmi_dolby_vision *dolby_vision, char *desc)
+{
+	sprintf(desc, "%s", drm_hdmi_connector_get_dolby_vision_name(*dolby_vision));
+}
+
+KUNIT_ARRAY_PARAM(check_dolby_vision, check_dolby_vision_tests,
+		  check_dolby_vision_desc);
+
+/*
+ * Test that standard Dolby Vision is accepted with full range RGB at 8
+ * bpc, and that turning it on triggers a mode change on the connector's
+ * CRTC, so that the infoframes get written again.
+ */
+static void drm_test_check_dolby_vision_crtc_mode_changed(struct kunit *test)
+{
+	const enum drm_hdmi_dolby_vision *dolby_vision = test->param_value;
+	struct drm_atomic_helper_connector_hdmi_priv *priv;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_atomic_state *state;
+	struct drm_display_mode *preferred;
+	struct drm_device *drm;
+	int ret;
+
+	priv = drm_kunit_helper_connector_hdmi_init(test,
+						    BIT(HDMI_COLORSPACE_RGB),
+						    8);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+
+	drm = &priv->drm;
+	preferred = find_preferred_mode(&priv->connector);
+	KUNIT_ASSERT_NOT_NULL(test, preferred);
+
+	drm_modeset_acquire_init(&ctx, 0);
+
+	state = drm_kunit_helper_atomic_state_alloc(test, drm, &ctx);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+
+	dolby_vision_conn_state(test, priv, state, preferred,
+				DRM_HDMI_DOLBY_VISION_OFF);
+
+	ret = drm_atomic_commit(state);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	state = drm_kunit_helper_atomic_state_alloc(test, drm, &ctx);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+
+	conn_state = drm_atomic_get_connector_state(state, &priv->connector);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, conn_state);
+	KUNIT_ASSERT_EQ(test, conn_state->hdmi.broadcast_rgb, DRM_HDMI_BROADCAST_RGB_FULL);
+
+	conn_state->hdmi.dolby_vision = *dolby_vision;
+
+	ret = drm_atomic_check_only(state);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	KUNIT_EXPECT_EQ(test, conn_state->hdmi.output_format, HDMI_COLORSPACE_RGB);
+	KUNIT_EXPECT_EQ(test, conn_state->hdmi.output_bpc, 8);
+	KUNIT_EXPECT_FALSE(test, conn_state->hdmi.is_limited_range);
+
+	crtc_state = drm_atomic_get_new_crtc_state(state, priv->crtc);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, crtc_state);
+	KUNIT_EXPECT_TRUE(test, crtc_state->mode_changed);
+
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+}
+
+/*
+ * Test that if we set the Dolby Vision property to the same value, we
+ * don't trigger a mode change on the connector's CRTC.
+ */
+static void drm_test_check_dolby_vision_crtc_mode_not_changed(struct kunit *test)
+{
+	const enum drm_hdmi_dolby_vision *dolby_vision = test->param_value;
+	struct drm_atomic_helper_connector_hdmi_priv *priv;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_atomic_state *state;
+	struct drm_display_mode *preferred;
+	struct drm_device *drm;
+	int ret;
+
+	priv = drm_kunit_helper_connector_hdmi_init(test,
+						    BIT(HDMI_COLORSPACE_RGB),
+						    8);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+
+	drm = &priv->drm;
+	preferred = find_preferred_mode(&priv->connector);
+	KUNIT_ASSERT_NOT_NULL(test, preferred);
+
+	drm_modeset_acquire_init(&ctx, 0);
+
+	state = drm_kunit_helper_atomic_state_alloc(test, drm, &ctx);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+
+	dolby_vision_conn_state(test, priv, state, preferred, *dolby_vision);
+
+	ret = drm_atomic_commit(state);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	state = drm_kunit_helper_atomic_state_alloc(test, drm, &ctx);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+
+	conn_state = drm_atomic_get_connector_state(state, &priv->connector);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, conn_state);
+	KUNIT_ASSERT_EQ(test, conn_state->hdmi.dolby_vision, *dolby_vision);
+
+	conn_state->hdmi.dolby_vision = *dolby_vision;
+
+	ret = drm_atomic_check_only(state);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	crtc_state = drm_atomic_get_new_crtc_state(state, priv->crtc);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, crtc_state);
+	KUNIT_EXPECT_FALSE(test, crtc_state->mode_changed);
+
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+}
+
+struct check_dolby_vision_reject_test {
+	const char *desc;
+	const unsigned char *edid;
+	size_t edid_len;
+	unsigned int formats;
+	unsigned int max_bpc;
+	/* the change that breaks the output, on the preferred mode at 8 bpc */
+	u8 vic;
+	unsigned int max_requested_bpc;
+	enum drm_hdmi_broadcast_rgb broadcast_rgb;
+	enum drm_colorspace colorspace;
+	bool hdr_output_metadata;
+};
+
+#define DOLBY_VISION_REJECT_TEST(_desc, _edid, _formats, _max_bpc, ...)	\
+	{								\
+		.desc = _desc,						\
+		.edid = _edid,						\
+		.edid_len = ARRAY_SIZE(_edid),				\
+		.formats = _formats,					\
+		.max_bpc = _max_bpc,					\
+		.max_requested_bpc = 8,					\
+		.broadcast_rgb = DRM_HDMI_BROADCAST_RGB_FULL,		\
+		.colorspace = DRM_MODE_COLORIMETRY_DEFAULT,		\
+		__VA_ARGS__						\
+	}
+
+static const struct check_dolby_vision_reject_test check_dolby_vision_reject_tests[] = {
+	DOLBY_VISION_REJECT_TEST("limited range",
+				 test_edid_hdmi_1080p_rgb_max_200mhz,
+				 BIT(HDMI_COLORSPACE_RGB), 8,
+				 .broadcast_rgb = DRM_HDMI_BROADCAST_RGB_LIMITED),
+	DOLBY_VISION_REJECT_TEST("automatic range, CEA mode",
+				 test_edid_hdmi_1080p_rgb_max_200mhz,
+				 BIT(HDMI_COLORSPACE_RGB), 8,
+				 .broadcast_rgb = DRM_HDMI_BROADCAST_RGB_AUTO),
+	DOLBY_VISION_REJECT_TEST("12 bpc",
+				 test_edid_hdmi_1080p_rgb_yuv_dc_max_340mhz,
+				 BIT(HDMI_COLORSPACE_RGB), 12,
+				 .max_requested_bpc = 12),
+	DOLBY_VISION_REJECT_TEST("YUV 4:2:0",
+				 test_edid_hdmi_1080p_rgb_yuv_4k_yuv420_dc_max_200mhz,
+				 BIT(HDMI_COLORSPACE_RGB) | BIT(HDMI_COLORSPACE_YUV420), 8,
+				 .vic = 95),
+	DOLBY_VISION_REJECT_TEST("BT.2020 colorspace",
+				 test_edid_hdmi_1080p_rgb_max_200mhz,
+				 BIT(HDMI_COLORSPACE_RGB), 8,
+				 .colorspace = DRM_MODE_COLORIMETRY_BT2020_RGB),
+	DOLBY_VISION_REJECT_TEST("HDR output metadata",
+				 test_edid_hdmi_1080p_rgb_max_200mhz,
+				 BIT(HDMI_COLORSPACE_RGB), 8,
+				 .hdr_output_metadata = true),
+	DOLBY_VISION_REJECT_TEST("interlaced mode",
+				 test_edid_hdmi_1080p_rgb_max_200mhz,
+				 BIT(HDMI_COLORSPACE_RGB), 8,
+				 .vic = 5),
+};
+
+static void
+check_dolby_vision_reject_desc(const struct check_dolby_vision_reject_test *t, char *desc)
+{
+	sprintf(desc, "%s", t->desc);
+}
+
+KUNIT_ARRAY_PARAM(check_dolby_vision_reject, check_dolby_vision_reject_tests,
+		  check_dolby_vision_reject_desc);
+
+static const enum drm_hdmi_dolby_vision dolby_vision_values[] = {
+	DRM_HDMI_DOLBY_VISION_OFF,
+	DRM_HDMI_DOLBY_VISION_STANDARD_HDMI_VSIF,
+	DRM_HDMI_DOLBY_VISION_STANDARD_DOLBY_VSIF,
+};
+
+/*
+ * Test that an output that would change the frames is rejected with
+ * either standard Dolby Vision signalling, and accepted without it: on a
+ * sink where full range RGB at 8 bpc takes both, a single change (range,
+ * bpc, format, colorspace, HDR metadata, interlacing) must be rejected.
+ */
+static void drm_test_check_dolby_vision_reject(struct kunit *test)
+{
+	const struct check_dolby_vision_reject_test *params = test->param_value;
+	struct drm_atomic_helper_connector_hdmi_priv *priv;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_connector_state *conn_state;
+	struct drm_atomic_state *state;
+	struct drm_display_mode *preferred, *mode;
+	struct drm_device *drm;
+	unsigned int i, broken;
+	int ret;
+
+	priv = __connector_hdmi_init(test, params->formats, params->max_bpc,
+				     &dummy_connector_hdmi_funcs,
+				     params->edid, params->edid_len);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+
+	drm = &priv->drm;
+	preferred = find_preferred_mode(&priv->connector);
+	KUNIT_ASSERT_NOT_NULL(test, preferred);
+
+	mode = preferred;
+	if (params->vic) {
+		mode = drm_kunit_display_mode_from_cea_vic(test, drm, params->vic);
+		KUNIT_ASSERT_NOT_NULL(test, mode);
+	}
+
+	drm_modeset_acquire_init(&ctx, 0);
+
+	for (broken = 0; broken < 2; broken++) {
+		for (i = 0; i < ARRAY_SIZE(dolby_vision_values); i++) {
+			const char *name =
+				drm_hdmi_connector_get_dolby_vision_name(dolby_vision_values[i]);
+
+			state = drm_kunit_helper_atomic_state_alloc(test, drm, &ctx);
+			KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+
+			conn_state = dolby_vision_conn_state(test, priv, state,
+							     broken ? mode : preferred,
+							     dolby_vision_values[i]);
+			conn_state->max_requested_bpc = 8;
+
+			if (broken) {
+				conn_state->max_requested_bpc = params->max_requested_bpc;
+				conn_state->hdmi.broadcast_rgb = params->broadcast_rgb;
+				conn_state->colorspace = params->colorspace;
+			}
+
+			if (broken && params->hdr_output_metadata) {
+				struct hdr_output_metadata metadata = {
+					.metadata_type = HDMI_STATIC_METADATA_TYPE1,
+					.hdmi_metadata_type1 = {
+						.eotf = HDMI_EOTF_SMPTE_ST2084,
+						.metadata_type = HDMI_STATIC_METADATA_TYPE1,
+						.max_display_mastering_luminance = 1000,
+					},
+				};
+				struct drm_property_blob *blob;
+
+				blob = drm_property_create_blob(drm, sizeof(metadata), &metadata);
+				KUNIT_ASSERT_NOT_ERR_OR_NULL(test, blob);
+				conn_state->hdr_output_metadata = blob;
+			}
+
+			ret = drm_atomic_check_only(state);
+			if (broken && dolby_vision_values[i] != DRM_HDMI_DOLBY_VISION_OFF)
+				KUNIT_EXPECT_EQ_MSG(test, ret, -EINVAL, "%s", name);
+			else
+				KUNIT_EXPECT_EQ_MSG(test, ret, 0, "%s, %s",
+						    broken ? params->desc : "unchanged", name);
+		}
+	}
+
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+}
+
+/*
+ * Test that Dolby Vision is rejected on a DVI sink, which gets no
+ * infoframes.
+ */
+static void drm_test_check_dolby_vision_dvi(struct kunit *test)
+{
+	struct drm_atomic_helper_connector_hdmi_priv *priv;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_atomic_state *state;
+	struct drm_display_mode *preferred;
+	struct drm_device *drm;
+	unsigned int i;
+	int ret;
+
+	priv = drm_kunit_helper_connector_hdmi_init_with_edid_funcs(test,
+				BIT(HDMI_COLORSPACE_RGB),
+				8,
+				&dummy_connector_hdmi_funcs,
+				test_edid_dvi_1080p);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+	KUNIT_ASSERT_FALSE(test, priv->connector.display_info.is_hdmi);
+
+	drm = &priv->drm;
+	preferred = find_preferred_mode(&priv->connector);
+	KUNIT_ASSERT_NOT_NULL(test, preferred);
+
+	drm_modeset_acquire_init(&ctx, 0);
+
+	for (i = 0; i < ARRAY_SIZE(dolby_vision_values); i++) {
+		state = drm_kunit_helper_atomic_state_alloc(test, drm, &ctx);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+
+		dolby_vision_conn_state(test, priv, state, preferred,
+					dolby_vision_values[i]);
+
+		ret = drm_atomic_check_only(state);
+		if (dolby_vision_values[i] == DRM_HDMI_DOLBY_VISION_OFF)
+			KUNIT_EXPECT_EQ(test, ret, 0);
+		else
+			KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+	}
+
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+}
+
+struct check_dolby_vision_infoframes_test {
+	enum drm_hdmi_dolby_vision dolby_vision;
+	u8 avi_vic;
+	u8 vendor[HDMI_INFOFRAME_SIZE(MAX)];
+	size_t vendor_len;
+};
+
+static const struct check_dolby_vision_infoframes_test check_dolby_vision_infoframes_tests[] = {
+	{
+		/* HDMI vendor infoframe, HDMI_VIC 1 */
