+	unsigned int kind;
+	const char *expected_name;
+};
+
+#define DOLBY_VISION_TEST(_kind, _name)	\
+	{					\
+		.kind = _kind,			\
+		.expected_name = _name,		\
+	}
+
+static void drm_test_drm_hdmi_connector_get_dolby_vision_name(struct kunit *test)
+{
+	const struct drm_hdmi_connector_get_dolby_vision_name_test *params =
+		test->param_value;
+
+	KUNIT_EXPECT_STREQ(test,
+			   drm_hdmi_connector_get_dolby_vision_name(params->kind),
+			   params->expected_name);
+}
+
+static const
+struct drm_hdmi_connector_get_dolby_vision_name_test
+drm_hdmi_connector_get_dolby_vision_name_valid_tests[] = {
+	DOLBY_VISION_TEST(DRM_HDMI_DOLBY_VISION_OFF, "Off"),
+	DOLBY_VISION_TEST(DRM_HDMI_DOLBY_VISION_STANDARD_HDMI_VSIF, "Standard (HDMI VSIF)"),
+	DOLBY_VISION_TEST(DRM_HDMI_DOLBY_VISION_STANDARD_DOLBY_VSIF, "Standard (Dolby VSIF)"),
+};
+
+static void
+drm_hdmi_connector_get_dolby_vision_name_valid_desc(
+	const struct drm_hdmi_connector_get_dolby_vision_name_test *t, char *desc)
+{
+	sprintf(desc, "%s", t->expected_name);
+}
+
+KUNIT_ARRAY_PARAM(drm_hdmi_connector_get_dolby_vision_name_valid,
+		  drm_hdmi_connector_get_dolby_vision_name_valid_tests,
+		  drm_hdmi_connector_get_dolby_vision_name_valid_desc);
+
+static void drm_test_drm_hdmi_connector_get_dolby_vision_name_invalid(struct kunit *test)
+{
+	KUNIT_EXPECT_NULL(test, drm_hdmi_connector_get_dolby_vision_name(3));
+};
+
+static struct kunit_case drm_hdmi_connector_get_dolby_vision_name_tests[] = {
+	KUNIT_CASE_PARAM(drm_test_drm_hdmi_connector_get_dolby_vision_name,
+			 drm_hdmi_connector_get_dolby_vision_name_valid_gen_params),
+	KUNIT_CASE(drm_test_drm_hdmi_connector_get_dolby_vision_name_invalid),
+	{ }
+};
+
+static struct kunit_suite drm_hdmi_connector_get_dolby_vision_name_test_suite = {
+	.name = "drm_hdmi_connector_get_dolby_vision_name",
+	.test_cases = drm_hdmi_connector_get_dolby_vision_name_tests,
+};
+
 struct drm_hdmi_connector_get_output_format_name_test {
 	unsigned int kind;
 	const char *expected_name;
@@ -1505,6 +1562,49 @@ static struct kunit_suite drm_connector_attach_broadcast_rgb_property_test_suite
 	.test_cases = drm_connector_attach_broadcast_rgb_property_tests,
 };
 
+static void drm_test_drm_connector_attach_dolby_vision_property(struct kunit *test)
+{
+	struct drm_connector_init_priv *priv = test->priv;
+	struct drm_connector *connector = &priv->connector;
+	struct drm_property *prop;
+	u64 val;
+	int ret;
+
+	ret = drmm_connector_hdmi_init(&priv->drm, connector,
+				       "Vendor", "Product",
+				       &dummy_funcs,
+				       &dummy_hdmi_funcs,
+				       DRM_MODE_CONNECTOR_HDMIA,
+				       &priv->ddc,
+				       BIT(HDMI_COLORSPACE_RGB),
+				       8);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	ret = drm_connector_attach_dolby_vision_property(connector);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	prop = connector->dolby_vision_property;
+	KUNIT_ASSERT_NOT_NULL(test, prop);
+	KUNIT_EXPECT_STREQ(test, prop->name, "Dolby Vision");
+	KUNIT_EXPECT_TRUE(test, prop->flags & DRM_MODE_PROP_ENUM);
+	KUNIT_EXPECT_NOT_NULL(test, drm_mode_obj_find_prop_id(&connector->base, prop->base.id));
+
+	ret = drm_object_property_get_default_value(&connector->base, prop, &val);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, val, DRM_HDMI_DOLBY_VISION_OFF);
+}
+
+static struct kunit_case drm_connector_attach_dolby_vision_property_tests[] = {
+	KUNIT_CASE(drm_test_drm_connector_attach_dolby_vision_property),
+	{ }
+};
+
+static struct kunit_suite drm_connector_attach_dolby_vision_property_test_suite = {
+	.name = "drm_connector_attach_dolby_vision_property",
+	.init = drm_test_connector_init,
+	.test_cases = drm_connector_attach_dolby_vision_property_tests,
+};
+
 /*
  * Test that for a given mode, with 8bpc and an RGB output the TMDS
  * character rate is equal to the mode pixel clock.
@@ -1829,9 +1929,11 @@ kunit_test_suites(
 	&drm_connector_dynamic_register_early_test_suite,
 	&drm_connector_dynamic_register_test_suite,
 	&drm_connector_attach_broadcast_rgb_property_test_suite,
+	&drm_connector_attach_dolby_vision_property_test_suite,
 	&drm_get_tv_mode_from_name_test_suite,
