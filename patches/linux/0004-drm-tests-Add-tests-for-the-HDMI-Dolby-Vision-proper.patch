+/*
+ * Test the vendor and AVI infoframes for each value of the Dolby Vision
+ * property, on 3840x2160@30Hz: a mode with both a VIC (95) and an HDMI_VIC
+ * (1). The HDMI vendor infoframe carries the HDMI_VIC, padded to 24 bytes
+ * or not; with the Dolby one, the VIC moves to the AVI infoframe.
+ */
+static void drm_test_check_dolby_vision_infoframes(struct kunit *test)
+{
+	const struct check_dolby_vision_infoframes_test *params = test->param_value;
+	struct drm_atomic_helper_connector_hdmi_priv *priv;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_connector_state *conn_state;
+	struct drm_atomic_state *state;
+	struct drm_display_mode *mode;
+	struct drm_device *drm;
+	u8 buffer[HDMI_INFOFRAME_SIZE(MAX)];
+	ssize_t len;
+	int ret;
+
+	priv = drm_kunit_helper_connector_hdmi_init_with_edid_funcs(test,
+				BIT(HDMI_COLORSPACE_RGB),
+				8,
+				&dummy_connector_hdmi_funcs,
+				test_edid_hdmi_4k_rgb_yuv420_dc_max_340mhz);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+	KUNIT_ASSERT_TRUE(test, priv->connector.display_info.has_hdmi_infoframe);
+
+	drm = &priv->drm;
+	mode = drm_kunit_display_mode_from_cea_vic(test, drm, 95);
+	KUNIT_ASSERT_NOT_NULL(test, mode);
+
+	drm_modeset_acquire_init(&ctx, 0);
+
+	state = drm_kunit_helper_atomic_state_alloc(test, drm, &ctx);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+
+	conn_state = dolby_vision_conn_state(test, priv, state, mode,
+					     params->dolby_vision);
+
+	ret = drm_atomic_check_only(state);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_EQ(test, conn_state->hdmi.output_format, HDMI_COLORSPACE_RGB);
+
+	KUNIT_ASSERT_TRUE(test, conn_state->hdmi.infoframes.avi.set);
+	KUNIT_EXPECT_EQ(test, conn_state->hdmi.infoframes.avi.data.avi.video_code,
+			params->avi_vic);
+
+	KUNIT_ASSERT_TRUE(test, conn_state->hdmi.infoframes.hdmi.set);
+	len = hdmi_infoframe_pack(&conn_state->hdmi.infoframes.hdmi.data,
+				  buffer, sizeof(buffer));
+	KUNIT_ASSERT_EQ(test, len, params->vendor_len);
+	KUNIT_EXPECT_MEMEQ(test, buffer, params->vendor, len);
+
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+}
