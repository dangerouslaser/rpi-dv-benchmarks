 drivers/gpu/drm/drm_atomic_uapi.c |  4 ++
 drivers/gpu/drm/drm_connector.c   | 96 +++++++++++++++++++++++++++++++
 include/drm/drm_connector.h       | 39 +++++++++++++
 4 files changed, 141 insertions(+)

