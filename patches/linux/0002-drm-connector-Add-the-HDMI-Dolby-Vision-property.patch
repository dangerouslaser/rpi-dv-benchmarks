diff --git a/drivers/gpu/drm/drm_connector.c b/drivers/gpu/drm/drm_connector.c
index 79eeaf66d..6105bdea8 100644
--- a/drivers/gpu/drm/drm_connector.c
+++ b/drivers/gpu/drm/drm_connector.c
@@ -1473,6 +1473,29 @@ drm_hdmi_connector_get_broadcast_rgb_name(enum drm_hdmi_broadcast_rgb broadcast_
 }
 EXPORT_SYMBOL(drm_hdmi_connector_get_broadcast_rgb_name);
 
+static const struct drm_prop_enum_list dolby_vision_names[] = {
+	{ DRM_HDMI_DOLBY_VISION_OFF, "Off" },
+	{ DRM_HDMI_DOLBY_VISION_STANDARD_HDMI_VSIF, "Standard (HDMI VSIF)" },
+	{ DRM_HDMI_DOLBY_VISION_STANDARD_DOLBY_VSIF, "Standard (Dolby VSIF)" },
+};
+
+/*
+ * drm_hdmi_connector_get_dolby_vision_name - Return the name of a Dolby Vision signalling
+ * @dolby_vision: Dolby Vision signalling to compute the name of
+ *
+ * Returns: the name of the Dolby Vision signalling, or NULL if the value is
+ * not valid.
+ */
+const char *
+drm_hdmi_connector_get_dolby_vision_name(enum drm_hdmi_dolby_vision dolby_vision)
+{
+	if (dolby_vision >= ARRAY_SIZE(dolby_vision_names))
+		return NULL;
+
+	return dolby_vision_names[dolby_vision].name;
+}
+EXPORT_SYMBOL(drm_hdmi_connector_get_dolby_vision_name);
+
 static const char * const output_format_str[] = {
 	[HDMI_COLORSPACE_RGB]		= "RGB",
 	[HDMI_COLORSPACE_YUV420]	= "YUV 4:2:0",
@@ -2005,6 +2028,43 @@ EXPORT_SYMBOL(drm_connector_attach_dp_subconnector_property);
  *      Drivers can set up this property by calling
  *      drm_connector_attach_broadcast_rgb_property().
  *
+ * Dolby Vision (HDMI specific)
+ *      Signals standard (TV-led) Dolby Vision to the sink. Its frames carry
+ *      the Dolby Vision signal, the video and its metadata, tunnelled in
+ *      8-bit RGB, and the sink does the display mapping. User-space makes
+ *      those frames; the kernel sends the signalling, a vendor-specific
+ *      infoframe.
+ *
+ *      The value of this property can be one of the following:
+ *
+ *      Off:
+ *              No Dolby Vision signalling. This is the default.
+ *
+ *      Standard (HDMI VSIF):
+ *              The HDMI vendor-specific infoframe (OUI 00-0C-03) is padded
+ *              with zeros to 24 bytes, which a Dolby Vision sink takes as
+ *              the Dolby Vision signal.
+ *
+ *      Standard (Dolby VSIF):
+ *              The Dolby vendor-specific infoframe (OUI 00-D0-46), with
+ *              Dolby_Vision_Signal set, is sent instead of the HDMI one. The
+ *              AVI infoframe then carries the VIC of the modes the HDMI one
+ *              would signal with an HDMI_VIC (the HDMI 1.4b 4k modes).
+ *
+ *      Sinks with a version 2 Dolby Vision Vendor-Specific Video Data Block
+ *      in their EDID are commonly sent the Dolby infoframe, others the HDMI
+ *      one. The kernel doesn't parse that block: user-space chooses.
+ *
+ *      Any value but Off needs an output that carries the frames unchanged.
+ *      A commit is rejected unless the output is RGB at 8 bpc (``max bpc``
+ *      may have to be 8) and full range (``Broadcast RGB`` set to Full for
+ *      CTA-861 modes), ``Colorspace`` is Default, no ``HDR_OUTPUT_METADATA``
+ *      is set, the mode is progressive and not 3D, and the sink is an HDMI
+ *      (not DVI) sink. Changing the value needs a modeset.
+ *
+ *      Drivers can set up this property by calling
+ *      drm_connector_attach_dolby_vision_property().
+ *
  * content type (HDMI specific):
  *	Indicates content type setting to be used in HDMI infoframes to indicate
  *	content type for the external device, so that it adjusts its display
@@ -2953,6 +3013,42 @@ int drm_connector_attach_broadcast_rgb_property(struct drm_connector *connector)
 }
 EXPORT_SYMBOL(drm_connector_attach_broadcast_rgb_property);
 
+/**
+ * drm_connector_attach_dolby_vision_property - attach "Dolby Vision" property
+ * @connector: connector to attach the property on.
+ *
+ * This is used to add support for signalling standard (TV-led) Dolby Vision
+ * on an HDMI connector. Drivers using it must check the connector state with
+ * drm_atomic_helper_connector_hdmi_check() and write the infoframes with
+ * drm_atomic_helper_connector_hdmi_update_infoframes().
+ *
+ * Returns:
+ * Zero on success, negative errno on failure.
+ */
+int drm_connector_attach_dolby_vision_property(struct drm_connector *connector)
+{
+	struct drm_device *dev = connector->dev;
+	struct drm_property *prop;
+
+	prop = connector->dolby_vision_property;
+	if (!prop) {
+		prop = drm_property_create_enum(dev, DRM_MODE_PROP_ENUM,
+						"Dolby Vision",
+						dolby_vision_names,
+						ARRAY_SIZE(dolby_vision_names));
+		if (!prop)
+			return -EINVAL;
+
+		connector->dolby_vision_property = prop;
+	}
+
+	drm_object_attach_property(&connector->base, prop,
+				   DRM_HDMI_DOLBY_VISION_OFF);
+
+	return 0;
+}
+EXPORT_SYMBOL(drm_connector_attach_dolby_vision_property);
+
 /**
  * drm_connector_attach_colorspace_property - attach "Colorspace" property
  * @connector: connector to attach the property on.
diff --git a/include/drm/drm_connector.h b/include/drm/drm_connector.h
index 1ea4cf8b6..7ad5e35e0 100644
--- a/include/drm/drm_connector.h
+++ b/include/drm/drm_connector.h
@@ -405,6 +405,32 @@ drm_hdmi_connector_get_broadcast_rgb_name(enum drm_hdmi_broadcast_rgb broadcast_
 const char *
 drm_hdmi_connector_get_output_format_name(enum hdmi_colorspace fmt);
 
+/**
+ * enum drm_hdmi_dolby_vision - Dolby Vision signalling for an HDMI @drm_connector
+ */
+enum drm_hdmi_dolby_vision {
+	/**
+	 * @DRM_HDMI_DOLBY_VISION_OFF: No Dolby Vision signalling.
+	 */
+	DRM_HDMI_DOLBY_VISION_OFF,
+
+	/**
+	 * @DRM_HDMI_DOLBY_VISION_STANDARD_HDMI_VSIF: Standard (TV-led)
+	 * Dolby Vision, signalled with the HDMI vendor-specific infoframe
+	 * padded to 24 bytes.
+	 */
+	DRM_HDMI_DOLBY_VISION_STANDARD_HDMI_VSIF,
+
+	/**
+	 * @DRM_HDMI_DOLBY_VISION_STANDARD_DOLBY_VSIF: Standard (TV-led)
+	 * Dolby Vision, signalled with the Dolby vendor-specific infoframe.
+	 */
+	DRM_HDMI_DOLBY_VISION_STANDARD_DOLBY_VSIF,
+};
+
+const char *
+drm_hdmi_connector_get_dolby_vision_name(enum drm_hdmi_dolby_vision dolby_vision);
+
